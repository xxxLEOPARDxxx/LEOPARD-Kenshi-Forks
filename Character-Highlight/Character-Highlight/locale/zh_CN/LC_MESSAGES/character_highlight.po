msgid ""
msgstr ""
"Project-Id-Version: CharacterHighlight\n"
"Language: zh_CN\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Allies"
msgstr "盟友"

msgid "Characters farther than this from the centre of the camera are not tinted. 0 - no limit."
msgstr "距离镜头中心超过此距离的角色不着色。0 - 不限制。"

msgid "Colour of neutrals when they are not coloured by relation, #RRGGBB."
msgstr "不按关系着色时中立者的颜色，#RRGGBB。"

msgid "Colour of those allied with all your characters, #RRGGBB."
msgstr "与你所有角色结盟者的颜色，#RRGGBB。"

msgid "Colour of those hostile to you, #RRGGBB."
msgstr "对你敌对者的颜色，#RRGGBB。"

msgid "Colour of your characters, #RRGGBB."
msgstr "你的角色的颜色，#RRGGBB。"

msgid "Colours"
msgstr "颜色"

msgid "Detailed log"
msgstr "详细日志"

msgid "Diagnostics"
msgstr "诊断"

msgid "Distance, m"
msgstr "距离（米）"

msgid "Enabled"
msgstr "启用"

msgid "Enemies"
msgstr "敌人"

msgid "Every 10 seconds in RE_Kenshi_log.txt: how many characters are known and how much work was done."
msgstr "每 10 秒写入 RE_Kenshi_log.txt：已知角色数量和完成的工作量。"

msgid "General"
msgstr "常规"

msgid "Neutrals by relation"
msgstr "中立者按关系着色"

msgid "Neutrals go from red to yellow to green with their faction's relation to you. Off - the neutral colour below."
msgstr "中立者按其派系对你的关系从红到黄到绿。关闭 - 使用下方的中立颜色。"

msgid "Neutrals"
msgstr "中立者"

msgid "Show through walls"
msgstr "透过墙壁可见"

msgid "Tint characters while the highlight key is held."
msgstr "按住高亮键时为角色着色。"

msgid "Tinted characters are visible through walls and buildings."
msgstr "着色的角色可透过墙壁和建筑看到。"

msgid "While the highlight key is held, characters are tinted by how they stand to you."
msgstr "按住高亮键时，角色按与你的关系着色。"

msgid "Your squad"
msgstr "你的小队"

msgid "Show key"
msgstr "显示按键"

msgid "Squad colour"
msgstr "小队颜色"

msgid "Enemy colour"
msgstr "敌人颜色"

msgid "Ally colour"
msgstr "盟友颜色"

msgid "Neutral colour"
msgstr "中立者颜色"

msgid "Diplomat colour"
msgstr "外交官颜色"

msgid "Who"
msgstr "着色对象"

msgid "Tint your own characters."
msgstr "为你的角色着色。"

msgid "Tint those hostile to you."
msgstr "为对你敌对者着色。"

msgid "Tint those allied with all your characters."
msgstr "为与你所有角色结盟者着色。"

msgid "Tint everyone else."
msgstr "为其他所有人着色。"

msgid "Diplomats"
msgstr "外交官"

msgid "Faction diplomats (diplomatic status) get a colour of their own, whatever their faction's relation to you."
msgstr "派系外交官（外交身份）使用单独的颜色，无论其派系与你的关系如何。"

msgid "Colour of faction diplomats, #RRGGBB."
msgstr "派系外交官的颜色，#RRGGBB。"

msgid "The tint shows while this key is held. NONE (Backspace when assigning) - always on."
msgstr "按住此键时显示着色。NONE（设置时按 Backspace）- 始终显示。"

msgid "Highlight characters and show NPC names in relationship colours."
msgstr "按关系颜色高亮角色并显示 NPC 名称。"

msgid "Enable hold-key and hover highlighting."
msgstr "启用按键高亮和鼠标悬停高亮。"

msgid "Tint intensity, %"
msgstr "染色强度，%"

msgid "100 - full colour; lower values preserve clothing and skin detail. This changes the tint, not the character's visibility."
msgstr "100 为完全染色；较低数值保留衣物和皮肤细节。此项改变染色强度，不会让角色变透明。"

msgid "Under the cursor"
msgstr "鼠标悬停"

msgid "Highlight under cursor"
msgstr "高亮鼠标下的角色"

msgid "Highlight the character or animal under the cursor without holding the show key. Off by default."
msgstr "无需按住高亮键即可高亮鼠标下的角色或动物。默认关闭。"

msgid "NPC names"
msgstr "NPC 名称"

msgid "Show NPC names"
msgstr "显示 NPC 名称"

msgid "Show relationship-coloured names above visible NPCs while holding the names key. Your squad keeps its usual labels."
msgstr "按住名称快捷键时，在画面中的 NPC 头顶以关系颜色显示名称。玩家队员保留原有名称标签。"

msgid "Names key"
msgstr "名称快捷键"

msgid "Hold this key to show NPC names. NONE leaves names visible while enabled."
msgstr "按住此键显示 NPC 名称。设为 NONE 时，开启功能后持续显示名称。"

msgid "Names horizontal offset, px"
msgstr "名称水平偏移，像素"

msgid "Positive values move names to the right."
msgstr "正值使名称向右移动。"

msgid "Names vertical offset, px"
msgstr "名称垂直偏移，像素"

msgid "Positive values move names up."
msgstr "正值使名称向上移动。"
