msgid "Who"
msgstr "Who"

msgid "Tint your own characters."
msgstr "Tint your own characters."

msgid "Tint those hostile to you."
msgstr "Tint those hostile to you."

msgid "Tint those allied with all your characters."
msgstr "Tint those allied with all your characters."

msgid "Tint everyone else."
msgstr "Tint everyone else."

msgid "Diplomats"
msgstr "Diplomats"

msgid "Faction diplomats (diplomatic status) get a colour of their own, whatever their faction's relation to you."
msgstr "Faction diplomats (diplomatic status) get a colour of their own, whatever their faction's relation to you."

msgid "Colour of faction diplomats, #RRGGBB."
msgstr "Colour of faction diplomats, #RRGGBB."

msgid "The tint shows while this key is held. NONE (Backspace when assigning) - always on."
msgstr "The tint shows while this key is held. NONE (Backspace when assigning) - always on."

msgid "Highlight characters and show NPC names in relationship colours."
msgstr "Highlight characters and show NPC names in relationship colours."

msgid "Enable hold-key and hover highlighting."
msgstr "Enable hold-key and hover highlighting."

msgid "Tint intensity, %"
msgstr "Tint intensity, %"

msgid "100 - full colour; lower values preserve clothing and skin detail. This changes the tint, not the character's visibility."
msgstr "100 - full colour; lower values preserve clothing and skin detail. This changes the tint, not the character's visibility."

msgid "Contour style"
msgstr "Contour style"

msgid "Contours instead of tint"
msgstr "Contours instead of tint"

msgid "Use coloured contours for the show key and relationship-coloured hover. Off keeps the original model tint. Contours follow visible models and equipment."
msgstr "Use coloured contours for the show key and relationship-coloured hover. Off keeps the original model tint. Contours follow visible models and equipment."

msgid "Contour width, px"
msgstr "Contour width, px"

msgid "Thickness of both beige and relationship-coloured contours."
msgstr "Thickness of both beige and relationship-coloured contours."

msgid "Contour brightness, %"
msgstr "Contour brightness, %"

msgid "Brightness of contours. 100 is the original colour; 0 hides contours. Model tint has its own intensity setting."
msgstr "Brightness of contours. 100 is the original colour; 0 hides contours. Model tint has its own intensity setting."

msgid "Under the cursor"
msgstr "Under the cursor"

msgid "Highlight under cursor"
msgstr "Highlight under cursor"

msgid "Highlight the character or animal under the cursor without holding the show key. Off by default."
msgstr "Highlight the character or animal under the cursor without holding the show key. Off by default."

msgid "Hover colours by relation"
msgstr "Hover colours by relation"

msgid "On - use this mod's relationship colours and chosen highlight style. Off - the basic hover contour colour."
msgstr "On - use this mod's relationship colours and chosen highlight style. Off - the basic hover contour colour."

msgid "Basic hover contour colour"
msgstr "Basic hover contour colour"

msgid "Colour used under the cursor when relationship colours are disabled."
msgstr "Colour used under the cursor when relationship colours are disabled."

msgid "Edge pass (diagnostics)"
msgstr "Edge pass (diagnostics)"

msgid "Draw the contour over the scene. Off renders only the mask - a performance test."
msgstr "Draw the contour over the scene. Off renders only the mask - a performance test."

msgid "NPC names"
msgstr "NPC names"

msgid "Show NPC names"
msgstr "Show NPC names"

msgid "Show relationship-coloured names above visible NPCs while holding the names key. Your squad keeps its usual labels."
msgstr "Show relationship-coloured names above visible NPCs while holding the names key. Your squad keeps its usual labels."

msgid "Names key"
msgstr "Names key"

msgid "Hold this key to show NPC names. NONE leaves names visible while enabled."
msgstr "Hold this key to show NPC names. NONE leaves names visible while enabled."

msgid "Names horizontal offset, px"
msgstr "Names horizontal offset, px"

msgid "Positive values move names to the right."
msgstr "Positive values move names to the right."

msgid "Names vertical offset, px"
msgstr "Names vertical offset, px"

msgid "Positive values move names up."
msgstr "Positive values move names up."
