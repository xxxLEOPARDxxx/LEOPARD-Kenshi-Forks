        case WM_PAINT:
        {
            PAINTSTRUCT paint = {};


            HDC hdc =
                BeginPaint(
                    hwnd,
                    &paint
                );


            BetterLooting611PaintBackground(
                hwnd,
                hdc
            );


            EndPaint(
                hwnd,
                &paint
            );


            return 0;
        }


        case WM_ERASEBKGND:
        {
            return 1;
        }


        case WM_CTLCOLORSTATIC:
        {
            HDC hdc =
                reinterpret_cast<HDC>(
                    wParam
                );


            HWND control =
                reinterpret_cast<HWND>(
                    lParam
                );


            const bool isTitle =
                control ==
                g_bl611Title;


            const bool isSection =
                control == g_bl611SectionSettings ||
                control == g_bl611SectionBehavior ||
                control == g_bl611SectionCategories ||
                control == g_bl611NProfileLabel;


            const bool isStatus =
                control ==
                g_bl611HStatus;


            const bool isBehaviorHelp =
                control ==
                g_bl611BehaviorHelp;


            const COLORREF background =
                isTitle
                    ? RGB(28, 29, 26)
                    : (
                        isStatus
                            ? RGB(29, 30, 27)
                            : BL_BSP_COLOR_PANEL
                    );


            SetBkMode(
                hdc,
                OPAQUE
            );


            SetBkColor(
                hdc,
                background
            );


            SetTextColor(
                hdc,
                isSection
                    ? RGB(211, 157, 78)
                    : (
                        isStatus
                            ? (
                                g_bl611KDirty
                                    ? RGB(229, 179, 74)
                                    : RGB(196, 220, 154)
                            )
                            : (
                                isBehaviorHelp
                                    ? RGB(164, 174, 151)
                                    : BL_BSP_COLOR_TEXT
                            )
                    )
            );


            SetDCBrushColor(
                hdc,
                background
            );


            return
                reinterpret_cast<LRESULT>(
                    GetStockObject(
                        DC_BRUSH
                    )
                );
        }


        case WM_CTLCOLOREDIT:
        {
            HDC hdc =
                reinterpret_cast<HDC>(
                    wParam
                );


            HWND control =
                reinterpret_cast<HWND>(
                    lParam
                );


            const bool invalid =
                (
                    control == g_blBspEditRadius &&
                    g_bl611HRadiusInvalid
                ) ||
                (
                    control == g_blBspEditMinValue &&
                    g_bl611HMinValueInvalid
                ) ||
                (
                    control == g_blBspEditMinValuePerKg &&
                    g_bl611HMinValuePerKgInvalid
                );


            const bool focused =
                GetFocus() ==
                control;


            const COLORREF background =
                invalid
                    ? RGB(61, 31, 28)
                    : (
                        focused
                            ? RGB(31, 32, 28)
                            : BL_BSP_COLOR_EDIT
                    );


            SetTextColor(
                hdc,
                invalid
                    ? RGB(246, 220, 207)
                    : BL_BSP_COLOR_TEXT
            );


            SetBkColor(
                hdc,
                background
            );


            SetDCBrushColor(
                hdc,
                background
            );


            return
                reinterpret_cast<LRESULT>(
                    GetStockObject(
                        DC_BRUSH
                    )
                );
        }


        case WM_CTLCOLORBTN:
        {
            HDC hdc =
                reinterpret_cast<HDC>(
                    wParam
                );


            SetBkMode(
                hdc,
                OPAQUE
            );


            SetBkColor(
                hdc,
                BL_BSP_COLOR_PANEL
            );


            SetTextColor(
                hdc,
                BL_BSP_COLOR_TEXT
            );


            return
                reinterpret_cast<LRESULT>(
                    g_blBspBrushPanel
                );
        }


        case WM_CTLCOLORLISTBOX:
        {
            HDC hdc =
                reinterpret_cast<HDC>(
                    wParam
                );


            SetTextColor(
                hdc,
                BL_BSP_COLOR_TEXT
            );


            SetBkColor(
                hdc,
                BL_BSP_COLOR_EDIT
            );


            return
                reinterpret_cast<LRESULT>(
                    g_blBspBrushEdit
                );
        }


        case WM_DRAWITEM:
        {
            const DRAWITEMSTRUCT* drawItem =
                reinterpret_cast<DRAWITEMSTRUCT*>(
                    lParam
                );


            if (!drawItem)
            {
                break;
            }


            if (
                drawItem->CtlType ==
                ODT_BUTTON
            )
            {
                BetterLooting611DrawButton(
                    drawItem
                );


                return TRUE;
            }


            if (
                drawItem->CtlType ==
                ODT_COMBOBOX
            )
            {
                BetterLooting611DrawCombo(
                    drawItem
                );


                return TRUE;
            }


            break;
        }


        case WM_TIMER:
        {
            if (
                wParam ==
                BL_UI_611H_TIMER_STATUS
            )
            {
                KillTimer(
                    hwnd,
                    BL_UI_611H_TIMER_STATUS
                );


                BetterLooting611KRefreshDirtyStatus(
                    hwnd
                );


                return 0;
            }


            break;
        }


        case WM_COMMAND:
        {
            if (
                reinterpret_cast<HWND>(
                    lParam
                ) ==
                    g_blBspComboLanguage &&
                HIWORD(
                    wParam
                ) ==
                    CBN_SELCHANGE
            )
            {
                BetterLootingBspSave();


                ErrorLog(
                    "BetterLooting: BSP_UI language changed, refreshing window"
                );


                DestroyWindow(
                    hwnd
                );


                CreateBetterLootingBspWindow();


                if (g_blBspWindow)
                {
                    BetterLootingBspBeginMenuCursorSession();

                    ShowWindow(
                        g_blBspWindow,
                        SW_SHOWNORMAL
                    );


                    SetWindowPos(
                        g_blBspWindow,
                        HWND_TOP,
                        0,
                        0,
                        0,
                        0,
                        SWP_NOMOVE |
                            SWP_NOSIZE
                    );


                    SetForegroundWindow(
                        g_blBspWindow
                    );
                }


                return 0;
            }


            const int id =
                LOWORD(
                    wParam
                );


            const int notification =
                HIWORD(
                    wParam
                );


            HWND commandSource =
                reinterpret_cast<HWND>(
                    lParam
                );


            if (
                notification == EN_CHANGE &&
                (
                    commandSource == g_blBspEditRadius ||
                    commandSource == g_blBspEditMinValue ||
                    commandSource == g_blBspEditMinValuePerKg
                )
            )
            {
                BetterLooting611HValidateInputs();


                if (
                    !g_bl611KSuppressTracking &&
                    IsWindowVisible(
                        hwnd
                    )
                )
                {
                    BetterLooting611KMarkCustomDirty(
                        hwnd
                    );
                }


                return 0;
            }


            if (
                notification == CBN_SELCHANGE &&
                commandSource ==
                    g_blBspComboActivationKey
            )
            {
                BetterLooting611KMarkCustomDirty(
                    hwnd
                );


                return 0;
            }


            if (
                notification == BN_CLICKED &&
                BetterLooting611KIsTrackedCheck(
                    commandSource
                )
            )
            {
                BetterLooting611KMarkCustomDirty(
                    hwnd
                );


                return 0;
            }


            if (
                id == BL_UI_611_ID_LANG_ES ||
                id == BL_UI_611_ID_LANG_EN
            )
            {
                g_blBspSpanish =
                    id ==
                    BL_UI_611_ID_LANG_ES;


                if (g_blBspComboLanguage)
                {
                    SendMessageA(
                        g_blBspComboLanguage,
                        CB_SETCURSEL,
                        g_blBspSpanish
                            ? 0
                            : 1,
                        0
                    );
                }


                g_bl611KSuppressTracking =
                    true;


                BetterLootingBspSave();


                g_bl611KSuppressTracking =
                    false;


                BetterLooting611KMarkSaved(
                    hwnd
                );


ErrorLog(
                    g_blBspSpanish
                        ? "BetterLooting: BSP_UI language button=es"
                        : "BetterLooting: BSP_UI language button=en"
                );


                DestroyWindow(
                    hwnd
                );


                CreateBetterLootingBspWindow();


                if (g_blBspWindow)
                {
                    BetterLootingBspBeginMenuCursorSession();

                    ShowWindow(
                        g_blBspWindow,
                        SW_SHOWNORMAL
                    );


                    SetWindowPos(
                        g_blBspWindow,
                        HWND_TOP,
                        0,
                        0,
                        0,
                        0,
                        SWP_NOMOVE |
                            SWP_NOSIZE
                    );


                    SetForegroundWindow(
                        g_blBspWindow
                    );
                }


                return 0;
            }            if (id == BL_UI_611J_ID_BALANCED)
            {
                BetterLooting611JApplyBalancedPreset();


                BetterLooting611KSelectPreset(
                    hwnd,
                    BL_UI_611J_ID_BALANCED
                );


                BetterLooting611HValidateInputs();


                BetterLooting611HShowStatus(
                    hwnd,
                    "EQUILIBRADO LISTO - PULSA GUARDAR",
                    "BALANCED READY - PRESS SAVE",
                    3200
                );


                ErrorLog(
                    "BetterLooting: BSP_UI preset balanced loaded not saved"
                );


                return 0;
            }


            if (id == BL_UI_611J_ID_MONEY)
            {
                BetterLooting611JApplyMoneyPreset();


                BetterLooting611KSelectPreset(
                    hwnd,
                    BL_UI_611J_ID_MONEY
                );


                BetterLooting611HValidateInputs();


                BetterLooting611HShowStatus(
                    hwnd,
                    "DINERO LISTO - PULSA GUARDAR",
                    "MONEY READY - PRESS SAVE",
                    3200
                );


                ErrorLog(
                    "BetterLooting: BSP_UI preset money loaded not saved"
                );


                return 0;
            }


            if (id == BL_UI_611J_ID_RESOURCES)
            {
                BetterLooting611JApplyResourcesPreset();


                BetterLooting611KSelectPreset(
                    hwnd,
                    BL_UI_611J_ID_RESOURCES
                );


                BetterLooting611HValidateInputs();


                BetterLooting611HShowStatus(
                    hwnd,
                    "RECURSOS LISTO - PULSA GUARDAR",
                    "RESOURCES READY - PRESS SAVE",
                    3200
                );


                ErrorLog(
                    "BetterLooting: BSP_UI preset resources loaded not saved"
                );


                return 0;
            }





            if (id == BL_BSP_ID_DEFAULTS)
            {
                g_bl611KSuppressTracking =
                    true;


                BetterLootingBspApplyDefaults();


                g_bl611KSuppressTracking =
                    false;


                g_bl611KActivePresetId =
                    0;


                BetterLooting611KMarkSaved(
                    hwnd
                );


                BetterLooting611HValidateInputs();


                BetterLooting611HShowStatus(
                    hwnd,
                    "VALORES RESTABLECIDOS",
                    "DEFAULTS RESTORED",
                    2400
                );


                return 0;
            }


            if (id == BL_BSP_ID_CATEGORIES_ALL)
            {
                BetterLootingBspSetCheck(g_blBspCheckWeapons, true);
                BetterLootingBspSetCheck(g_blBspCheckArmour, true);
                BetterLootingBspSetCheck(g_blBspCheckMaterials, true);
                BetterLootingBspSetCheck(g_blBspCheckFood, true);
                BetterLootingBspSetCheck(g_blBspCheckMedicine, true);
                BetterLootingBspSetCheck(g_blBspCheckTools, true);
                BetterLootingBspSetCheck(g_blBspCheckAmmo, true);
                BetterLootingBspSetCheck(g_blBspCheckBlueprints, true);
                BetterLootingBspSetCheck(g_blBspCheckBooks, true);
                BetterLootingBspSetCheck(g_blBspCheckRobotics, true);
                BetterLootingBspSetCheck(g_blBspCheckNarcotics, true);
                BetterLootingBspSetCheck(g_blBspCheckSeveredLimbs, true);
                BetterLootingBspSetCheck(g_blBspCheckOther, true);

                BetterLooting611KMarkCustomDirty(
                    hwnd
                );


                return 0;
            }


            if (id == BL_BSP_ID_CATEGORIES_NONE)
            {
                BetterLootingBspSetCheck(g_blBspCheckWeapons, false);
                BetterLootingBspSetCheck(g_blBspCheckArmour, false);
                BetterLootingBspSetCheck(g_blBspCheckMaterials, false);
                BetterLootingBspSetCheck(g_blBspCheckFood, false);
                BetterLootingBspSetCheck(g_blBspCheckMedicine, false);
                BetterLootingBspSetCheck(g_blBspCheckTools, false);
                BetterLootingBspSetCheck(g_blBspCheckAmmo, false);
                BetterLootingBspSetCheck(g_blBspCheckBlueprints, false);
                BetterLootingBspSetCheck(g_blBspCheckBooks, false);
                BetterLootingBspSetCheck(g_blBspCheckRobotics, false);
                BetterLootingBspSetCheck(g_blBspCheckNarcotics, false);
                BetterLootingBspSetCheck(g_blBspCheckSeveredLimbs, false);
                BetterLootingBspSetCheck(g_blBspCheckOther, false);

                BetterLooting611KMarkCustomDirty(
                    hwnd
                );


                return 0;
            }


            if (id == BL_BSP_ID_STORE_ALL)
            {
                if (!BetterLooting611HValidateInputs())
                {
                    BetterLooting611HShowStatus(
                        hwnd,
                        "REVISA LOS CAMPOS MARCADOS",
                        "CHECK THE HIGHLIGHTED FIELDS",
                        3200
                    );


                    return 0;
                }


                g_bl611KSuppressTracking =
                    true;


                BetterLootingBspSave();


                g_bl611KSuppressTracking =
                    false;


                BetterLooting611KMarkSaved(
                    hwnd
                );


                const LONG previousRequest =
                    InterlockedExchange(
                        &g_storeAllRequested,
                        1
                    );


                BetterLooting611HShowStatus(
                    hwnd,
                    previousRequest == 0
                        ? "DEPOSITAR TODO EN COLA"
                        : "DEPOSITAR TODO YA ESTABA EN COLA",
                    previousRequest == 0
                        ? "DEPOSIT EVERYTHING QUEUED"
                        : "DEPOSIT EVERYTHING ALREADY QUEUED",
                    3200
                );


                ErrorLog(
                    previousRequest == 0
                        ? "BetterLooting: STORE_ALL REQUESTED"
                        : "BetterLooting: STORE_ALL REQUEST_ALREADY_PENDING"
                );


                return 0;
            }


            if (id == BL_BSP_ID_SAVE)
            {
                if (!BetterLooting611HValidateInputs())
                {
                    BetterLooting611HShowStatus(
                        hwnd,
                        "REVISA LOS CAMPOS MARCADOS",
                        "CHECK THE HIGHLIGHTED FIELDS",
                        3200
                    );


                    return 0;
                }


                g_bl611KSuppressTracking =
                    true;


                BetterLootingBspSave();


                g_bl611KSuppressTracking =
                    false;


                BetterLooting611KMarkSaved(
                    hwnd
                );


                BetterLooting611KShowSavedStatus(
                    hwnd
                );


                return 0;
            }


            if (id == BL_UI_611_ID_CLOSE_X || id == BL_BSP_ID_CLOSE)
            {
                BetterLooting611KDiscardPendingState(
                    hwnd
                );


                ShowWindow(
                    hwnd,
                    SW_HIDE
                );

                BetterLootingBspEndMenuCursorSession();

                return 0;
            }


            break;
        }


        case WM_NCHITTEST:
        {
            const LRESULT hit =
                DefWindowProcA(
                    hwnd,
                    msg,
                    wParam,
                    lParam
                );


            if (hit == HTCLIENT)
            {
                POINT point = {};


                point.x =
                    static_cast<short>(
                        LOWORD(
                            lParam
                        )
                    );


                point.y =
                    static_cast<short>(
                        HIWORD(
                            lParam
                        )
                    );


                ScreenToClient(
                    hwnd,
                    &point
                );


                if (
                    point.y >= 16 &&
                    point.y < 68 &&
                    point.x >= 18 &&
                    point.x < 912
                )
                {
                    return HTCAPTION;
                }
            }


            return hit;
        }


        case WM_CLOSE:
        {
            BetterLooting611KDiscardPendingState(
                hwnd
            );


            ShowWindow(
                hwnd,
                SW_HIDE
            );

            BetterLootingBspEndMenuCursorSession();

            return 0;
        }


        case WM_DESTROY:
        {
            if (
                g_bl611ITooltip &&
                IsWindow(
                    g_bl611ITooltip
                )
            )
            {
                DestroyWindow(
                    g_bl611ITooltip
                );
            }


            g_bl611ITooltip =
                NULL;


            if (g_bl611LUxThemeModule)
            {
                FreeLibrary(
                    g_bl611LUxThemeModule
                );

                g_bl611LUxThemeModule =
                    NULL;
            }


            if (g_bl611IComCtlModule)
            {
                FreeLibrary(
                    g_bl611IComCtlModule
                );

                g_bl611IComCtlModule =
                    NULL;
            }


KillTimer(
                hwnd,
                BL_UI_611H_TIMER_STATUS
            );


            g_bl611HStatus =
                NULL;


            g_bl611BehaviorHelp =
                NULL;


            g_bl611HRadiusInvalid =
                false;


            g_bl611HMinValueInvalid =
                false;


            g_bl611HMinValuePerKgInvalid =
                false;


g_blBspWindow =
                NULL;

            g_blBspComboActivationKey =
                NULL;

            g_blBspComboLanguage =
                NULL;

            return 0;
        }
    }


    return
        DefWindowProcA(
            hwnd,
            msg,
            wParam,
            lParam
        );
}


static void CreateBetterLootingBspWindow()
{
    if (g_blBspWindow)
    {
        return;
    }


    BetterLootingBspCreateGuiResources();


    HWND ownerWindow =
        BetterLootingBspGetKenshiMainWindow();


    WNDCLASSEXA wc;

    ZeroMemory(
        &wc,
        sizeof(wc)
    );


    wc.cbSize =
        sizeof(wc);

    wc.lpfnWndProc =
        BetterLootingBspWndProc;

    wc.hInstance =
        reinterpret_cast<HINSTANCE>(
            &__ImageBase
        );

    wc.lpszClassName =
        "BetterLootingBspWindowClass";

    wc.hCursor =
        LoadCursor(
            NULL,
            IDC_ARROW
        );

    wc.hbrBackground =
        g_blBspBrushBackground;


    RegisterClassExA(
        &wc
    );


    const int width =
        980;


    const int height =
        640;


    int x =
        (
            GetSystemMetrics(
                SM_CXSCREEN
            ) -
            width
        ) /
        2;


    int y =
        (
            GetSystemMetrics(
                SM_CYSCREEN
            ) -
            height
        ) /
        2;


    if (ownerWindow)
    {
        RECT rect;

        GetWindowRect(
            ownerWindow,
            &rect
        );


        x =
            rect.left +
            (
                (
                    rect.right -
                    rect.left
                ) -
                width
            ) /
            2;


        y =
            rect.top +
            (
                (
                    rect.bottom -
                    rect.top
                ) -
                height
            ) /
            2;
    }


    g_blBspWindow =
        CreateWindowExA(
            WS_EX_TOOLWINDOW,
            "BetterLootingBspWindowClass",
            "Better Looting",
            WS_POPUP |
                WS_CLIPCHILDREN,
            x,
            y,
            width,
            height,
            ownerWindow,
            NULL,
            reinterpret_cast<HINSTANCE>(
                &__ImageBase
            ),
            NULL
        );


    if (!g_blBspWindow)
    {
        ErrorLog(
            "BetterLooting: BSP_UI could not create Win32 window"
        );

        return;
    }


    ErrorLog(
        "BetterLooting: BSP_UI window created"
    );
}


static void ToggleBetterLootingBspWindow()
{
    if (
        !BetterLootingBspIsKenshiProcessInForeground()
    )
    {
        return;
    }


    if (!g_blBspWindow)
    {
        CreateBetterLootingBspWindow();
    }


    if (!g_blBspWindow)
    {
        return;
    }


    if (
        IsWindowVisible(
            g_blBspWindow
        )
    )
    {
        ShowWindow(
            g_blBspWindow,
            SW_HIDE
        );

        BetterLootingBspEndMenuCursorSession();
    }
    else
    {
        BetterLootingBspSyncFromRules();


        BetterLooting611KRefreshDirtyStatus(
            g_blBspWindow
        );


        BetterLootingBspBeginMenuCursorSession();

        ShowWindow(
            g_blBspWindow,
            SW_SHOWNORMAL
        );


        SetWindowPos(
            g_blBspWindow,
            HWND_TOP,
            0,
            0,
            0,
            0,
            SWP_NOMOVE |
                SWP_NOSIZE
        );


        SetForegroundWindow(
            g_blBspWindow
        );
    }
}


static DWORD WINAPI BetterLootingBspUiThread(
    LPVOID
)
{
    ErrorLog(
        "BetterLooting: BSP_UI input thread started"
    );


    bool wasDown =
        false;


    while (true)
    {
        MSG msg;


        while (
            PeekMessageA(
                &msg,
                NULL,
                0,
                0,
                PM_REMOVE
            )
        )
        {
            TranslateMessage(
                &msg
            );

            DispatchMessageA(
                &msg
            );
        }


        if (
            g_blBspWindow &&
            IsWindowVisible(
                g_blBspWindow
            ) &&
            !BetterLootingBspIsKenshiProcessInForeground()
        )
        {
            ShowWindow(
                g_blBspWindow,
                SW_HIDE
            );

            BetterLootingBspEndMenuCursorSession();
        }


        const bool isDown =
            (
                GetAsyncKeyState(
                    VK_SHIFT
                ) &
                0x8000
            ) != 0 &&
            (
                GetAsyncKeyState(
                    'P'
                ) &
                0x8000
            ) != 0;


        if (
            isDown &&
            !wasDown
        )
        {
            ErrorLog(
                "BetterLooting: BSP_UI SHIFT_P pressed"
            );

            ToggleBetterLootingBspWindow();
        }


        wasDown =
            isDown;


        Sleep(
            25
        );
    }


    return 0;
}

__declspec(dllexport) void startPlugin()
{
    ErrorLog(
        "BetterLooting: startPlugin called"
    );

    LoadBetterLootingRules();

    if (
        KenshiLib::SUCCESS !=
        KenshiLib::AddHook(
            KenshiLib::GetRealAddress(
                &Inventory::getExcessLoot
            ),
            InventoryGetExcessLoot_hook,
            &g_origInventoryGetExcessLoot
        )
    )
    {
        ErrorLog(
            "BetterLooting: AUTODEPOSIT_HOOK_FAILED getExcessLoot"
        );
    }
    else
    {
        ErrorLog(
            "BetterLooting: selective auto-deposit protection hook installed"
        );
    }


    KenshiLib::AddHook(
        KenshiLib::GetRealAddress(
            &InventoryGUI::_NV_update
        ),
        InventoryGUIUpdate_hook,
        &g_origInventoryGUIUpdate
    );

    KenshiLib::AddHook(
        KenshiLib::GetRealAddress(
            &ForgottenGUI::showInventory
        ),
        ShowInventory_hook,
        &g_origShowInventory
    );

    KenshiLib::AddHook(
        KenshiLib::GetRealAddress(
            &ForgottenGUI::showInventoryNPC
        ),
        ShowInventoryNPC_hook,
        &g_origShowInventoryNPC
    );

    KenshiLib::AddHook(
        KenshiLib::GetRealAddress(
            &ForgottenGUI::showInventoryBuilding
        ),
        ShowInventoryBuilding_hook,
        &g_origShowInventoryBuilding
    );

    KenshiLib::AddHook(
        KenshiLib::GetRealAddress(
            &ForgottenGUI::showTraderInventory
        ),
        ShowTraderInventory_hook,
        &g_origShowTraderInventory
    );

    ErrorLog(
        "BetterLooting: classifier hooks installed"
    );

    HANDLE betterLootingBspUiThreadHandle =
        CreateThread(
            NULL,
            0,
            BetterLootingBspUiThread,
            NULL,
            0,
            NULL
        );


    if (betterLootingBspUiThreadHandle)
    {
        CloseHandle(
            betterLootingBspUiThreadHandle
        );

        ErrorLog(
            "BetterLooting: BSP_UI thread created"
        );
    }
    else
    {
        ErrorLog(
            "BetterLooting: BSP_UI thread creation failed"
        );
    }
}
