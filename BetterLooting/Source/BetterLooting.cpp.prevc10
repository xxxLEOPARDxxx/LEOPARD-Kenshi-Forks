    sizeof(g_blBspHotkeyValues) /
    sizeof(g_blBspHotkeyValues[0]);


static int BetterLootingBspFindHotkeyIndex(
    int virtualKey
)
{
    for (
        int i = 0;
        i < g_blBspHotkeyCount;
        ++i
    )
    {
        if (
            g_blBspHotkeyValues[i] ==
            virtualKey
        )
        {
            return i;
        }
    }


    return 0;
}

