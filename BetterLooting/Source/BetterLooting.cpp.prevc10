static void BetterLooting611FrameRect(
    HDC hdc,
    const RECT& rect,
    COLORREF color
)
{
    HBRUSH brush =
        CreateSolidBrush(
            color
        );


    FrameRect(
        hdc,
        &rect,
        brush
    );


    DeleteObject(
        brush
    );
}


static void BetterLooting611PaintBackground(
    HWND hwnd,
    HDC hdc
)
{
    RECT client = {};


    GetClientRect(
        hwnd,
        &client
    );


    FillRect(
        hdc,
        &client,
        g_blBspBrushBackground
    );


    HBRUSH headerBrush =
        CreateSolidBrush(
            RGB(
                28,
                29,
                26
            )
        );


    HBRUSH footerBrush =
        CreateSolidBrush(
            RGB(
                29,
                30,
                27
            )
        );


    RECT outer =
    {
        8,
        8,
        client.right - 8,
        client.bottom - 8
    };


    RECT header =
    {
        18,
        16,
        client.right - 18,
        68
    };


    RECT settings =
    {
        24,
        82,
        476,
        314
    };


    RECT behavior =
    {
        24,
        326,
        476,
        520
    };


    RECT categories =
    {
        492,
        82,
        956,
        520
    };


    RECT footer =
    {
        24,
        532,
        956,
        612
    };


    FillRect(
        hdc,
        &header,
        headerBrush
    );


    FillRect(
        hdc,
        &settings,
        g_blBspBrushPanel
    );


    FillRect(
        hdc,
        &behavior,
        g_blBspBrushPanel
    );


    FillRect(
        hdc,
        &categories,
        g_blBspBrushPanel
    );


    FillRect(
        hdc,
        &footer,
        footerBrush
    );


    BetterLooting611FrameRect(
        hdc,
        outer,
        RGB(
            103,
            96,
            77
        )
    );


    BetterLooting611FrameRect(
        hdc,
        header,
        RGB(
            80,
            78,
            67
        )
    );


    BetterLooting611FrameRect(
        hdc,
        settings,
        RGB(
            80,
            78,
            67
        )
    );


    BetterLooting611FrameRect(
        hdc,
        behavior,
        RGB(
            80,
            78,
            67
        )
    );


    BetterLooting611FrameRect(
        hdc,
        categories,
        RGB(
            80,
            78,
            67
        )
    );


    BetterLooting611FrameRect(
        hdc,
        footer,
        RGB(
            80,
            78,
            67
        )
    );


    HPEN dividerPen =
        CreatePen(
            PS_SOLID,
            1,
            RGB(
                72,
                70,
                60
            )
        );


    HGDIOBJ oldDividerPen =
        SelectObject(
            hdc,
            dividerPen
        );


    MoveToEx(
        hdc,
        512,
        380,
        NULL
    );


    LineTo(
        hdc,
        936,
        380
    );


    MoveToEx(
        hdc,
        512,
        444,
        NULL
    );


    LineTo(
        hdc,
        936,
        444
    );


    SelectObject(
        hdc,
        oldDividerPen
    );


    DeleteObject(
        dividerPen
    );


    HPEN accentPen =
        CreatePen(
            PS_SOLID,
            2,
            RGB(
                171,
                125,
                58
            )
        );


    HGDIOBJ oldPen =
        SelectObject(
            hdc,
            accentPen
        );


    MoveToEx(
        hdc,
        58,
        62,
        NULL
    );


    LineTo(
        hdc,
        client.right - 58,
        62
    );


    SelectObject(
        hdc,
        oldPen
    );


    DeleteObject(
        accentPen
    );


    DeleteObject(
        headerBrush
    );


    DeleteObject(
        footerBrush
    );
}


static COLORREF BetterLooting611ButtonFill(
    UINT id,
    UINT state
)
{
    const bool pressed =
        (
            state &
            ODS_SELECTED
        ) !=
        0;


    const bool disabled =
        (
            state &
            ODS_DISABLED
        ) !=
        0;


    if (disabled)
    {
        return
            RGB(
                47,
                47,
                43
            );
    }    if (
        id == BL_UI_611_ID_LANG_ES ||
        id == BL_UI_611_ID_LANG_EN
    )
    {
        const bool active =
            id == BL_UI_611_ID_LANG_ES
                ? g_blBspSpanish
                : !g_blBspSpanish;


        if (pressed)
        {
            return
                active
                    ? RGB(96, 68, 33)
                    : RGB(45, 46, 42);
        }


        return
            active
                ? RGB(126, 88, 40)
                : RGB(50, 51, 47);
    }







        if (
        id == BL_UI_611J_ID_BALANCED ||
        id == BL_UI_611J_ID_MONEY ||
        id == BL_UI_611J_ID_RESOURCES
    )
    {
        const bool active =
            id ==
            g_bl611KActivePresetId;


        if (pressed)
        {
            return
                active
                    ? RGB(104, 73, 33)
                    : RGB(48, 49, 44);
        }


        return
            active
                ? RGB(139, 96, 42)
                : RGB(62, 63, 57);
    }


    if (id == BL_UI_611_ID_CLOSE_X)
    {
        return
            pressed
                ? RGB(82, 48, 35)
                : RGB(105, 63, 42);
    }


    if (id == BL_BSP_ID_SAVE)
    {
        if (g_bl611KDirty)
        {
            return
                pressed
                    ? RGB(104, 69, 33)
                    : RGB(139, 91, 42);
        }


        return
            pressed
                ? RGB(48, 49, 44)
                : RGB(62, 63, 57);
    }


    if (id == BL_BSP_ID_STORE_ALL)
    {
        return
            pressed
                ? RGB(104, 73, 33)
                : RGB(139, 96, 42);
    }


    if (id == BL_BSP_ID_CLOSE)
    {
        return
            pressed
                ? RGB(54, 45, 41)
                : RGB(72, 60, 55);
    }


    if (id == BL_BSP_ID_DEFAULTS)
    {
        return
            pressed
                ? RGB(44, 45, 41)
                : RGB(58, 59, 54);
    }


    return
        pressed
            ? RGB(48, 49, 44)
            : RGB(62, 63, 57);
}


static void BetterLooting611FDrawFlag(
    HDC hdc,
    const RECT& flagRect,
    bool spanish
)
{
    if (spanish)
    {
        const int height =
            flagRect.bottom -
            flagRect.top;


        const int redBand =
            height / 4;


        HBRUSH redBrush =
            CreateSolidBrush(
                RGB(159, 45, 42)
            );


        HBRUSH yellowBrush =
            CreateSolidBrush(
                RGB(218, 164, 61)
            );


        RECT top =
        {
            flagRect.left,
            flagRect.top,
            flagRect.right,
            flagRect.top + redBand
        };


        RECT middle =
        {
            flagRect.left,
            flagRect.top + redBand,
            flagRect.right,
            flagRect.bottom - redBand
        };


        RECT bottom =
        {
            flagRect.left,
            flagRect.bottom - redBand,
            flagRect.right,
            flagRect.bottom
        };


        FillRect(
            hdc,
            &top,
            redBrush
        );


        FillRect(
            hdc,
            &middle,
            yellowBrush
        );


        FillRect(
            hdc,
            &bottom,
            redBrush
        );


        DeleteObject(
            redBrush
        );


        DeleteObject(
            yellowBrush
        );
    }
    else
    {
        HBRUSH redBrush =
            CreateSolidBrush(
                RGB(164, 53, 50)
            );


        HBRUSH whiteBrush =
            CreateSolidBrush(
                RGB(229, 225, 211)
            );


        HBRUSH blueBrush =
            CreateSolidBrush(
                RGB(55, 71, 107)
            );


        const int height =
            flagRect.bottom -
            flagRect.top;


        for (
            int stripe = 0;
            stripe < 7;
            ++stripe
        )
        {
            RECT stripeRect =
            {
                flagRect.left,
                flagRect.top +
                    (
                        stripe *
                        height /
                        7
                    ),
                flagRect.right,
                flagRect.top +
                    (
                        (stripe + 1) *
                        height /
                        7
                    )
            };


            FillRect(
                hdc,
                &stripeRect,
                (stripe % 2) == 0
                    ? redBrush
                    : whiteBrush
            );
        }


        RECT canton =
        {
            flagRect.left,
            flagRect.top,
            flagRect.left +
                (
                    (
                        flagRect.right -
                        flagRect.left
                    ) *
                    2 /
                    5
                ),
            flagRect.top +
                (
                    height *
                    4 /
                    7
                )
        };


        FillRect(
            hdc,
            &canton,
            blueBrush
        );


        DeleteObject(
            redBrush
        );


        DeleteObject(
            whiteBrush
        );


        DeleteObject(
            blueBrush
        );
    }


    BetterLooting611FrameRect(
        hdc,
        flagRect,
        RGB(119, 116, 98)
    );
}




static void BetterLooting611DrawButton(
    const DRAWITEMSTRUCT* drawItem
)
{
    if (!drawItem)
    {
        return;
    }


    RECT rect =
        drawItem->rcItem;


    HBRUSH fill =
        CreateSolidBrush(
            BetterLooting611ButtonFill(
                drawItem->CtlID,
                drawItem->itemState
            )
        );


    FillRect(
        drawItem->hDC,
        &rect,
        fill
    );


    DeleteObject(
        fill
    );


    const bool activePreset =
        drawItem->CtlID ==
            static_cast<UINT>(
                g_bl611KActivePresetId
            ) &&
        (
            drawItem->CtlID == BL_UI_611J_ID_BALANCED ||
            drawItem->CtlID == BL_UI_611J_ID_MONEY ||
            drawItem->CtlID == BL_UI_611J_ID_RESOURCES
        );


    const bool activeLanguage =
        (
            drawItem->CtlID == BL_UI_611_ID_LANG_ES &&
            g_blBspSpanish
        ) ||
        (
            drawItem->CtlID == BL_UI_611_ID_LANG_EN &&
            !g_blBspSpanish
        );


    const COLORREF borderColor =
        activePreset
            ? RGB(218, 164, 61)
            : (
                activeLanguage
                    ? RGB(196, 151, 78)
                    : (
                        drawItem->CtlID ==
                            BL_BSP_ID_SAVE
                                ? (
                                    g_bl611KDirty
                                        ? RGB(211, 151, 73)
                                        : RGB(119, 116, 98)
                                )
                                : (
                                    drawItem->CtlID ==
                                        BL_UI_611_ID_CLOSE_X
                                            ? RGB(151, 104, 68)
                                            : (
                                                drawItem->CtlID ==
                                                    BL_BSP_ID_STORE_ALL
                                                        ? RGB(211, 151, 73)
                                                        : (
                                                            drawItem->CtlID ==
                                                                BL_BSP_ID_CLOSE
                                                                    ? RGB(136, 98, 84)
                                                                    : (
                                                                        drawItem->CtlID ==
                                                                            BL_BSP_ID_DEFAULTS
                                                                                ? RGB(104, 102, 88)
                                                                                : RGB(119, 116, 98)
                                                                    )
                                                        )
                                            )
                                )
                    )
            );


    BetterLooting611FrameRect(
        drawItem->hDC,
        rect,
        borderColor
    );


    RECT inner =
        rect;


    InflateRect(
        &inner,
        -3,
        -3
    );


    const COLORREF innerBorderColor =
        activePreset
            ? RGB(126, 88, 43)
            : (
                activeLanguage
                    ? RGB(104, 77, 41)
                    : (
                        drawItem->CtlID == BL_BSP_ID_STORE_ALL
                            ? RGB(126, 88, 43)
                            : (
                                drawItem->CtlID == BL_BSP_ID_CLOSE
                                    ? RGB(95, 77, 69)
                                    : RGB(76, 74, 63)
                            )
                    )
            );


    BetterLooting611FrameRect(
        drawItem->hDC,
        inner,
        innerBorderColor
    );    if (
        drawItem->CtlID == BL_UI_611_ID_LANG_ES ||
        drawItem->CtlID == BL_UI_611_ID_LANG_EN
    )
    {
        const bool spanish =
            drawItem->CtlID ==
            BL_UI_611_ID_LANG_ES;


        RECT flagRect =
        {
            rect.left + 8,
            rect.top + 9,
            rect.left + 34,
            rect.bottom - 9
        };


        BetterLooting611FDrawFlag(
            drawItem->hDC,
            flagRect,
            spanish
        );


        RECT languageText =
        {
            rect.left + 40,
            rect.top,
            rect.right - 5,
            rect.bottom
        };


        HGDIOBJ oldFont =
            SelectObject(
                drawItem->hDC,
                g_blBspFontButton
            );


        SetBkMode(
            drawItem->hDC,
            TRANSPARENT
        );


        SetTextColor(
            drawItem->hDC,
            RGB(
                241,
                234,
                214
            )
        );


        DrawTextA(
            drawItem->hDC,
            spanish
                ? "ES"
                : "EN",
            -1,
            &languageText,
            DT_CENTER |
                DT_VCENTER |
                DT_SINGLELINE |
                DT_NOPREFIX
        );


        SelectObject(
            drawItem->hDC,
            oldFont
        );


        


        return;
    }







    char caption[128] = {};


    GetWindowTextA(
        drawItem->hwndItem,
        caption,
        sizeof(caption)
    );


    HGDIOBJ oldFont =
        SelectObject(
            drawItem->hDC,
            g_blBspFontButton
        );


    SetBkMode(
        drawItem->hDC,
        TRANSPARENT
    );


    SetTextColor(
        drawItem->hDC,
        RGB(
            241,
            234,
            214
        )
    );


    DrawTextA(
        drawItem->hDC,
        caption,
        -1,
        &rect,
        DT_CENTER |
            DT_VCENTER |
            DT_SINGLELINE |
            DT_NOPREFIX
    );


    SelectObject(
        drawItem->hDC,
        oldFont
    );


    
}


static void BetterLooting611DrawCombo(
    const DRAWITEMSTRUCT* drawItem
)
{
    if (!drawItem)
    {
        return;
    }


    RECT rect =
        drawItem->rcItem;


    const bool selected =
        (
            drawItem->itemState &
            ODS_SELECTED
        ) !=
        0;


    const bool focused =
        (
            drawItem->itemState &
            ODS_FOCUS
        ) !=
        0;


    const COLORREF fillColor =
        selected
            ? RGB(92, 72, 40)
            : (
                focused
                    ? RGB(32, 33, 29)
                    : BL_BSP_COLOR_EDIT
            );


    HBRUSH background =
        CreateSolidBrush(
            fillColor
        );


    FillRect(
        drawItem->hDC,
        &rect,
        background
    );


    DeleteObject(
        background
    );


    RECT textRect =
        rect;


    textRect.left += 10;
    textRect.right -= 6;


    SetBkMode(
        drawItem->hDC,
        TRANSPARENT
    );


    SetTextColor(
        drawItem->hDC,
        selected
            ? RGB(245, 236, 211)
            : BL_BSP_COLOR_TEXT
    );


    HGDIOBJ oldFont =
        SelectObject(
            drawItem->hDC,
            g_blBspFontNormal
        );


    if (
        drawItem->itemID !=
        static_cast<UINT>(-1)
    )
    {
        if (
            drawItem->hwndItem ==
            g_blBspComboLanguage
        )
        {
            wchar_t text[128] = {};


            SendMessageW(
                drawItem->hwndItem,
                CB_GETLBTEXT,
                drawItem->itemID,
                reinterpret_cast<LPARAM>(
                    text
                )
            );


            DrawTextW(
                drawItem->hDC,
                text,
                -1,
                &textRect,
                DT_LEFT |
                    DT_VCENTER |
                    DT_SINGLELINE |
                    DT_NOPREFIX
            );
        }
        else
        {
            char text[128] = {};


            SendMessageA(
                drawItem->hwndItem,
                CB_GETLBTEXT,
                drawItem->itemID,
                reinterpret_cast<LPARAM>(
                    text
                )
            );


            DrawTextA(
                drawItem->hDC,
                text,
                -1,
                &textRect,
                DT_LEFT |
                    DT_VCENTER |
                    DT_SINGLELINE |
                    DT_NOPREFIX
            );
        }
    }


    SelectObject(
        drawItem->hDC,
        oldFont
    );


    const COLORREF borderColor =
        selected
            ? RGB(211, 151, 73)
            : (
                focused
                    ? RGB(171, 125, 58)
                    : RGB(104, 101, 86)
            );


    BetterLooting611FrameRect(
        drawItem->hDC,
        rect,
        borderColor
    );
}

static BOOL CALLBACK BetterLootingBspEnumMainWindowProc(
    HWND hwnd,
    LPARAM lParam
)
{
    BetterLootingBspEnumWindowData* data =
        reinterpret_cast<BetterLootingBspEnumWindowData*>(
            lParam
        );


    DWORD windowProcessId = 0;

    GetWindowThreadProcessId(
        hwnd,
        &windowProcessId
    );


    if (windowProcessId != data->processId)
    {
        return TRUE;
    }


    if (!IsWindowVisible(hwnd))
    {
        return TRUE;
    }


    if (GetWindow(hwnd, GW_OWNER) != NULL)
    {
        return TRUE;
    }


    char title[256] = {};

    GetWindowTextA(
        hwnd,
        title,
        sizeof(title)
    );


    if (strlen(title) == 0)
    {
        return TRUE;
    }


    char className[256] = {};

    GetClassNameA(
        hwnd,
        className,
        sizeof(className)
    );


    if (
        strcmp(
            className,
            "BetterLootingBspWindowClass"
        ) == 0
    )
    {
        return TRUE;
    }


    data->hwnd =
        hwnd;

    return FALSE;
}


static HWND BetterLootingBspGetKenshiMainWindow()
{
    if (
        g_blBspGameWindow &&
        IsWindow(
            g_blBspGameWindow
        )
    )
    {
        return g_blBspGameWindow;
    }


    BetterLootingBspEnumWindowData data;

    data.processId =
        GetCurrentProcessId();

    data.hwnd =
        NULL;


    EnumWindows(
        BetterLootingBspEnumMainWindowProc,
        reinterpret_cast<LPARAM>(
            &data
        )
    );


    g_blBspGameWindow =
        data.hwnd;


    if (g_blBspGameWindow)
    {
        ErrorLog(
            "BetterLooting: BSP_UI Kenshi main window found"
        );
    }
    else
    {
        ErrorLog(
            "BetterLooting: BSP_UI Kenshi main window not found"
        );
    }


    return g_blBspGameWindow;
}


static bool BetterLootingBspIsKenshiProcessInForeground()
{
    HWND foreground =
        GetForegroundWindow();


    if (!foreground)
    {
        return false;
    }


    DWORD foregroundProcessId = 0;

    GetWindowThreadProcessId(
        foreground,
        &foregroundProcessId
    );


    return
        foregroundProcessId ==
        GetCurrentProcessId();
}


static std::string BetterLootingBspGetIniPath()
{
    char modulePath[MAX_PATH] = {};


    const DWORD length =
        GetModuleFileNameA(
            reinterpret_cast<HMODULE>(
                &__ImageBase
            ),
            modulePath,
            MAX_PATH
        );


    if (
        length == 0 ||
        length >= MAX_PATH
    )
    {
        return "BetterLooting.ini";
    }


    std::string path(
        modulePath,
        length
    );


    const std::string::size_type separator =
        path.find_last_of(
            "\\/"
        );


    if (separator == std::string::npos)
    {
        return "BetterLooting.ini";
    }


    return
        path.substr(
            0,
            separator + 1
        ) +
        "BetterLooting.ini";
}



// BL_FIX_SOFTWARE_MOUSE_CURSOR_POPUP

static bool BetterLootingBspQueryCursorVisible(
    bool& visible
)
{
    CURSORINFO cursorInfo = {};

    cursorInfo.cbSize =
        sizeof(cursorInfo);


    if (
        GetCursorInfo(
            &cursorInfo
        ) == FALSE
    )
    {
        return false;
    }


    visible =
        (
            cursorInfo.flags &
            CURSOR_SHOWING
        ) != 0;


    return true;
}


static void BetterLootingBspEnsureMenuCursor()
{
    if (!g_blBspArrowCursor)
    {
        g_blBspArrowCursor =
            LoadCursor(
                NULL,
                IDC_ARROW
            );
    }


    bool visible =
        false;


    if (
        BetterLootingBspQueryCursorVisible(
            visible
        ) &&
        !visible
    )
    {
        int attempts =
            0;


        while (
            !visible &&
            attempts < 64
        )
        {
            ShowCursor(
                TRUE
            );

            ++attempts;


            if (
                !BetterLootingBspQueryCursorVisible(
                    visible
                )
            )
            {
                break;
            }
        }


        if (attempts > 0)
        {
            char message[256];

            sprintf_s(
                message,
                "BetterLooting: BSP_UI CURSOR_SHOW attempts=%d visible=%d",
                attempts,
                visible ? 1 : 0
            );

            ErrorLog(
                message
            );
        }
    }


    if (g_blBspArrowCursor)
    {
        SetCursor(
            g_blBspArrowCursor
        );
    }
}


static void BetterLootingBspBeginMenuCursorSession()
{
    if (!g_blBspCursorSessionCaptured)
    {
        bool visible =
            false;


        if (
            BetterLootingBspQueryCursorVisible(
                visible
            )
        )
        {
            g_blBspCursorSessionCaptured =
                true;

            g_blBspCursorWasVisible =
                visible;


            ErrorLog(
                visible
                    ? "BetterLooting: BSP_UI CURSOR_SESSION_BEGIN initialVisible=1"
                    : "BetterLooting: BSP_UI CURSOR_SESSION_BEGIN initialVisible=0"
            );
        }
        else
        {
            ErrorLog(
                "BetterLooting: BSP_UI CURSOR_SESSION_BEGIN query_failed"
            );
        }
    }


    BetterLootingBspEnsureMenuCursor();
}


static void BetterLootingBspEndMenuCursorSession()
{
    if (!g_blBspCursorSessionCaptured)
    {
        return;
    }


    int hideAttempts =
        0;


    if (!g_blBspCursorWasVisible)
    {
        bool visible =
            false;


        while (
            hideAttempts < 64 &&
            BetterLootingBspQueryCursorVisible(
                visible
            ) &&
            visible
        )
        {
            ShowCursor(
                FALSE
            );

            ++hideAttempts;
        }
    }


    char message[256];

    sprintf_s(
        message,
        "BetterLooting: BSP_UI CURSOR_SESSION_END initialVisible=%d hideAttempts=%d",
        g_blBspCursorWasVisible ? 1 : 0,
        hideAttempts
    );

    ErrorLog(
        message
    );


    g_blBspCursorSessionCaptured =
        false;

    g_blBspCursorWasVisible =
        false;
}

static const char* BetterLootingBspText(
    const char* spanishText,
    const char* englishText
)
{
    return
        g_blBspSpanish
            ? spanishText
            : englishText;
}


static void BetterLootingBspLoadLanguage()
{
    const std::string iniPath =
        BetterLootingBspGetIniPath();


    char language[16] = {};


    GetPrivateProfileStringA(
        "UI",
        "Language",
        "es",
        language,
        sizeof(language),
        iniPath.c_str()
    );


    g_blBspSpanish =
        !(
            language[0] == 'e' &&
            language[1] == 'n'
        );


    if (g_blBspSpanish)
    {
        ErrorLog(
            "BetterLooting: BSP_UI language=es"
        );
    }
    else
    {
        ErrorLog(
            "BetterLooting: BSP_UI language=en"
        );
    }
}


static void BetterLootingBspSetCheck(
    HWND hwnd,
    bool checked
)
{
    if (!hwnd)
    {
        return;
    }


    SendMessageA(
        hwnd,
        BM_SETCHECK,
        checked ? BST_CHECKED : BST_UNCHECKED,
        0
    );
}


static bool BetterLootingBspGetCheck(
    HWND hwnd
)
{
    if (!hwnd)
    {
        return false;
    }


    return
        SendMessageA(
            hwnd,
            BM_GETCHECK,
            0,
            0
        ) ==
        BST_CHECKED;
}


static void BetterLootingBspSyncFromRules()
{
    char value[64] = {};


    sprintf_s(
        value,
        "%.2f",
        g_betterLootingRules.lootRadius
    );

    SetWindowTextA(
        g_blBspEditRadius,
        value
    );


    sprintf_s(
        value,
        "%d",
        g_betterLootingRules.minValue
    );

    SetWindowTextA(
        g_blBspEditMinValue,
        value
    );


    sprintf_s(
        value,
        "%.2f",
        g_betterLootingRules.minValuePerKg
    );

    SetWindowTextA(
        g_blBspEditMinValuePerKg,
        value
    );


    if (g_blBspComboActivationKey)
    {
        SendMessageA(
            g_blBspComboActivationKey,
            CB_SETCURSEL,
            BetterLootingBspFindHotkeyIndex(
                g_betterLootingRules.activationVirtualKey
            ),
            0
        );
    }


    BetterLootingBspSetCheck(g_blBspCheckWeapons, g_betterLootingRules.lootWeapons);
    BetterLootingBspSetCheck(g_blBspCheckArmour, g_betterLootingRules.lootArmour);
    BetterLootingBspSetCheck(g_blBspCheckMaterials, g_betterLootingRules.lootMaterials);
    BetterLootingBspSetCheck(g_blBspCheckFood, g_betterLootingRules.lootFood);
    BetterLootingBspSetCheck(g_blBspCheckMedicine, g_betterLootingRules.lootMedicine);
    BetterLootingBspSetCheck(g_blBspCheckTools, g_betterLootingRules.lootTools);
    BetterLootingBspSetCheck(g_blBspCheckAmmo, g_betterLootingRules.lootAmmo);
    BetterLootingBspSetCheck(g_blBspCheckBlueprints, g_betterLootingRules.lootBlueprints);
    BetterLootingBspSetCheck(g_blBspCheckBooks, g_betterLootingRules.lootBooks);
    BetterLootingBspSetCheck(g_blBspCheckRobotics, g_betterLootingRules.lootRobotics);
    BetterLootingBspSetCheck(g_blBspCheckNarcotics, g_betterLootingRules.lootNarcotics);
    BetterLootingBspSetCheck(g_blBspCheckSeveredLimbs, g_betterLootingRules.lootSeveredLimbs);
    BetterLootingBspSetCheck(g_blBspCheckOther, g_betterLootingRules.lootOther);

    BetterLootingBspSetCheck(g_blBspCheckAllowStolen, g_betterLootingRules.allowStolen);
    BetterLootingBspSetCheck(g_blBspCheckBestItemsFirst, g_betterLootingRules.bestItemsFirst);
    BetterLootingBspSetCheck(g_blBspCheckPreferBackpack, g_betterLootingRules.preferBackpack);


    if (g_blBspComboLanguage)
    {
        SendMessageA(
            g_blBspComboLanguage,
            CB_SETCURSEL,
            g_blBspSpanish ? 0 : 1,
            0
        );
    }
}


static void BetterLootingBspWriteBool(
    const std::string& iniPath,
    const char* section,
    const char* key,
    bool value
)
{
    WritePrivateProfileStringA(
        section,
        key,
        value ? "1" : "0",
        iniPath.c_str()
    );
}


static void BetterLootingBspSave()
{
    char textBuffer[64] = {};
    char* endPointer = NULL;


    GetWindowTextA(
        g_blBspEditRadius,
        textBuffer,
        sizeof(textBuffer)
    );


    float radius =
        strtof(
            textBuffer,
            &endPointer
        );


    if (
        endPointer == textBuffer ||
        radius != radius
    )
    {
        radius = 20.0f;
    }


    if (radius < 1.0f)
    {
        radius = 1.0f;
    }


    if (radius > 100.0f)
    {
        radius = 100.0f;
    }


    ZeroMemory(
        textBuffer,
        sizeof(textBuffer)
    );


    GetWindowTextA(
        g_blBspEditMinValue,
        textBuffer,
        sizeof(textBuffer)
    );


    long minValue =
        strtol(
            textBuffer,
            &endPointer,
            10
        );


    if (endPointer == textBuffer)
    {
        minValue = 0;
    }


    if (minValue < 0)
    {
        minValue = 0;
    }


    ZeroMemory(
        textBuffer,
        sizeof(textBuffer)
    );


    GetWindowTextA(
        g_blBspEditMinValuePerKg,
        textBuffer,
        sizeof(textBuffer)
    );


    float minValuePerKg =
        strtof(
            textBuffer,
            &endPointer
        );


    if (
        endPointer == textBuffer ||
        minValuePerKg != minValuePerKg
    )
    {
        minValuePerKg = 0.0f;
    }


    if (minValuePerKg < 0.0f)
    {
        minValuePerKg = 0.0f;
    }


    LRESULT hotkeySelection =
        SendMessageA(
            g_blBspComboActivationKey,
            CB_GETCURSEL,
            0,
            0
        );


    if (
        hotkeySelection < 0 ||
        hotkeySelection >= g_blBspHotkeyCount
    )
    {
        hotkeySelection = 0;
    }


    const int activationKey =
        g_blBspHotkeyValues[
            static_cast<int>(
                hotkeySelection
            )
        ];


    const LRESULT languageSelection =
        SendMessageA(
            g_blBspComboLanguage,
            CB_GETCURSEL,
            0,
            0
        );


    g_blBspSpanish =
        languageSelection != 1;


    g_betterLootingRules.lootRadius =
        radius;

    g_betterLootingRules.minValue =
        static_cast<int>(
            minValue
        );

    g_betterLootingRules.minValuePerKg =
        minValuePerKg;

    g_betterLootingRules.activationVirtualKey = activationKey;


    g_betterLootingRules.lootWeapons = BetterLootingBspGetCheck(g_blBspCheckWeapons);
    g_betterLootingRules.lootArmour = BetterLootingBspGetCheck(g_blBspCheckArmour);
    g_betterLootingRules.lootMaterials = BetterLootingBspGetCheck(g_blBspCheckMaterials);
    g_betterLootingRules.lootFood = BetterLootingBspGetCheck(g_blBspCheckFood);
    g_betterLootingRules.lootMedicine = BetterLootingBspGetCheck(g_blBspCheckMedicine);
    g_betterLootingRules.lootTools = BetterLootingBspGetCheck(g_blBspCheckTools);
    g_betterLootingRules.lootAmmo = BetterLootingBspGetCheck(g_blBspCheckAmmo);
    g_betterLootingRules.lootBlueprints = BetterLootingBspGetCheck(g_blBspCheckBlueprints);
    g_betterLootingRules.lootBooks = BetterLootingBspGetCheck(g_blBspCheckBooks);
    g_betterLootingRules.lootRobotics = BetterLootingBspGetCheck(g_blBspCheckRobotics);
    g_betterLootingRules.lootNarcotics = BetterLootingBspGetCheck(g_blBspCheckNarcotics);
    g_betterLootingRules.lootSeveredLimbs = BetterLootingBspGetCheck(g_blBspCheckSeveredLimbs);
    g_betterLootingRules.lootOther = BetterLootingBspGetCheck(g_blBspCheckOther);

    g_betterLootingRules.allowStolen = BetterLootingBspGetCheck(g_blBspCheckAllowStolen);
    g_betterLootingRules.bestItemsFirst = BetterLootingBspGetCheck(g_blBspCheckBestItemsFirst);
    g_betterLootingRules.preferBackpack = BetterLootingBspGetCheck(g_blBspCheckPreferBackpack);


    const std::string iniPath =
        BetterLootingBspGetIniPath();


    WritePrivateProfileStringA(
        "UI",
        "Language",
        g_blBspSpanish ? "es" : "en",
        iniPath.c_str()
    );


    char valueBuffer[64] = {};


    sprintf_s(
        valueBuffer,
        "%.2f",
        g_betterLootingRules.lootRadius
    );

    WritePrivateProfileStringA(
        "General",
        "LootRadius",
        valueBuffer,
        iniPath.c_str()
    );


    sprintf_s(
        valueBuffer,
        "%d",
        g_betterLootingRules.minValue
    );

    WritePrivateProfileStringA(
        "Rules",
        "MinValue",
        valueBuffer,
        iniPath.c_str()
    );


    sprintf_s(
        valueBuffer,
        "%.2f",
        g_betterLootingRules.minValuePerKg
    );

    WritePrivateProfileStringA(
        "Rules",
        "MinValuePerKg",
        valueBuffer,
        iniPath.c_str()
    );


    BetterLootingBspWriteBool(iniPath, "Rules", "AllowStolen", g_betterLootingRules.allowStolen);

    BetterLootingBspWriteBool(iniPath, "Categories", "Weapons", g_betterLootingRules.lootWeapons);
    BetterLootingBspWriteBool(iniPath, "Categories", "Armour", g_betterLootingRules.lootArmour);
    BetterLootingBspWriteBool(iniPath, "Categories", "Materials", g_betterLootingRules.lootMaterials);
    BetterLootingBspWriteBool(iniPath, "Categories", "Food", g_betterLootingRules.lootFood);
    BetterLootingBspWriteBool(iniPath, "Categories", "Medicine", g_betterLootingRules.lootMedicine);
    BetterLootingBspWriteBool(iniPath, "Categories", "Tools", g_betterLootingRules.lootTools);
    BetterLootingBspWriteBool(iniPath, "Categories", "Ammo", g_betterLootingRules.lootAmmo);
    BetterLootingBspWriteBool(iniPath, "Categories", "Blueprints", g_betterLootingRules.lootBlueprints);
    BetterLootingBspWriteBool(iniPath, "Categories", "Books", g_betterLootingRules.lootBooks);
    BetterLootingBspWriteBool(iniPath, "Categories", "Robotics", g_betterLootingRules.lootRobotics);
    BetterLootingBspWriteBool(iniPath, "Categories", "Narcotics", g_betterLootingRules.lootNarcotics);
    BetterLootingBspWriteBool(iniPath, "Categories", "SeveredLimbs", g_betterLootingRules.lootSeveredLimbs);
    BetterLootingBspWriteBool(iniPath, "Categories", "Other", g_betterLootingRules.lootOther);

    BetterLootingBspWriteBool(iniPath, "Behavior", "BestItemsFirst", g_betterLootingRules.bestItemsFirst);
    BetterLootingBspWriteBool(iniPath, "Behavior", "PreferBackpack", g_betterLootingRules.preferBackpack);


    sprintf_s(
        valueBuffer,
        "%d",
        g_betterLootingRules.activationVirtualKey
    );

    WritePrivateProfileStringA(
        "Behavior",
        "ActivationVirtualKey",
        valueBuffer,
        iniPath.c_str()
    );


    BetterLootingBspSyncFromRules();


    ErrorLog(
        "BetterLooting: BSP_UI settings saved"
    );
}


static void BetterLootingBspApplyDefaults()
{
    g_betterLootingRules.lootRadius = 20.00f;
    g_betterLootingRules.minValue = 0;
    g_betterLootingRules.minValuePerKg = 0.00f;
    g_betterLootingRules.allowStolen = true;

    g_betterLootingRules.lootWeapons = true;
    g_betterLootingRules.lootArmour = true;
    g_betterLootingRules.lootMaterials = true;
    g_betterLootingRules.lootFood = true;
    g_betterLootingRules.lootMedicine = true;
    g_betterLootingRules.lootTools = true;
    g_betterLootingRules.lootAmmo = true;
    g_betterLootingRules.lootBlueprints = true;
    g_betterLootingRules.lootBooks = true;
    g_betterLootingRules.lootRobotics = true;
    g_betterLootingRules.lootNarcotics = true;
    g_betterLootingRules.lootSeveredLimbs = true;
    g_betterLootingRules.lootOther = true;

    g_betterLootingRules.bestItemsFirst = true;
    g_betterLootingRules.preferBackpack = true;
    g_betterLootingRules.activationVirtualKey = VK_INSERT;

    BetterLootingBspSyncFromRules();
    BetterLootingBspSave();

    ErrorLog(
        "BetterLooting: BSP_UI checkpoint defaults restored and saved"
    );
}


static HWND BetterLootingBspCreateLabel(
    HWND parent,
    const char* text,
    int x,
    int y,
    int width,
    int height
)
{
    HWND control =
        CreateWindowExA(
            0,
            "STATIC",
            text,
            WS_CHILD | WS_VISIBLE,
            x,
            y,
            width,
            height,
            parent,
            NULL,
            reinterpret_cast<HINSTANCE>(
                &__ImageBase
            ),
            NULL
        );


    BetterLootingBspSetControlFont(
        control,
        g_blBspFontNormal
    );


    return control;
}


static HWND BetterLootingBspCreateEdit(
    HWND parent,
    int x,
    int y,
    int width,
    int height
)
{
    HWND control =
        CreateWindowExA(
            WS_EX_STATICEDGE,
            "EDIT",
            "",
            WS_CHILD |
                WS_VISIBLE |
                WS_TABSTOP |
                ES_AUTOHSCROLL,
            x,
            y,
            width,
            height,
            parent,
            NULL,
            reinterpret_cast<HINSTANCE>(
                &__ImageBase
            ),
            NULL
        );


    BetterLootingBspSetControlFont(
        control,
        g_blBspFontNormal
    );


    if (control)
    {
        SendMessageA(
            control,
            EM_SETMARGINS,
            EC_LEFTMARGIN |
                EC_RIGHTMARGIN,
            MAKELPARAM(
                8,
                8
            )
        );
    }


    return control;
}


static bool BetterLooting611HOnlyTrailingWhitespace(
    const char* text
)
{
    if (!text)
    {
        return true;
    }


    while (*text)
    {
        if (
            *text != ' ' &&
            *text != '\t' &&
            *text != '\r' &&
            *text != '\n'
        )
        {
            return false;
        }


        ++text;
    }


    return true;
}


static bool BetterLooting611HValidateFloatEdit(
    HWND edit,
    float minimum,
    float maximum
)
{
    if (!edit)
    {
        return false;
    }


    char buffer[64] = {};


    GetWindowTextA(
        edit,
        buffer,
        sizeof(buffer)
    );


    char* endPointer =
        NULL;


    const float value =
        strtof(
            buffer,
            &endPointer
        );


    if (
        endPointer == buffer ||
        value != value ||
        !BetterLooting611HOnlyTrailingWhitespace(
            endPointer
        )
    )
    {
        return false;
    }


    return
        value >= minimum &&
        value <= maximum;
}


static bool BetterLooting611HValidateIntegerEdit(
    HWND edit,
    long minimum,
    long maximum
)
{
    if (!edit)
    {
        return false;
    }


    char buffer[64] = {};


    GetWindowTextA(
        edit,
        buffer,
        sizeof(buffer)
    );


    char* endPointer =
        NULL;


    const long value =
        strtol(
            buffer,
            &endPointer,
            10
        );


    if (
        endPointer == buffer ||
        !BetterLooting611HOnlyTrailingWhitespace(
            endPointer
        )
    )
    {
        return false;
    }


    return
        value >= minimum &&
        value <= maximum;
}


static void BetterLooting611HRefreshEdit(
    HWND edit
)
{
    if (!edit)
    {
        return;
    }


    RedrawWindow(
        edit,
        NULL,
        NULL,
        RDW_INVALIDATE |
            RDW_ERASE |
            RDW_FRAME |
            RDW_UPDATENOW
    );
}


static bool BetterLooting611HValidateInputs()
{
    g_bl611HRadiusInvalid =
        !BetterLooting611HValidateFloatEdit(
            g_blBspEditRadius,
            1.0f,
            100.0f
        );


    g_bl611HMinValueInvalid =
        !BetterLooting611HValidateIntegerEdit(
            g_blBspEditMinValue,
            0L,
            2147483647L
        );


    g_bl611HMinValuePerKgInvalid =
        !BetterLooting611HValidateFloatEdit(
            g_blBspEditMinValuePerKg,
            0.0f,
            1000000000.0f
        );


    BetterLooting611HRefreshEdit(
        g_blBspEditRadius
    );


    BetterLooting611HRefreshEdit(
        g_blBspEditMinValue
    );


    BetterLooting611HRefreshEdit(
        g_blBspEditMinValuePerKg
    );


    return
        !g_bl611HRadiusInvalid &&
        !g_bl611HMinValueInvalid &&
        !g_bl611HMinValuePerKgInvalid;
}


static void BetterLooting611HShowStatus(
    HWND parent,
    const char* spanishText,
    const char* englishText,
    UINT durationMs
)
{
    if (!g_bl611HStatus)
    {
        return;
    }


    SetWindowTextA(
        g_bl611HStatus,
        g_blBspSpanish
            ? spanishText
            : englishText
    );


    InvalidateRect(
        g_bl611HStatus,
        NULL,
        TRUE
    );


    KillTimer(
        parent,
        BL_UI_611H_TIMER_STATUS
    );


    SetTimer(
        parent,
        BL_UI_611H_TIMER_STATUS,
        durationMs,
        NULL
    );
}

typedef BOOL (
    WINAPI*
    BetterLooting611IInitCommonControlsExFn
)(
    const INITCOMMONCONTROLSEX*
);


static bool BetterLooting611IEnsureCommonControls()
{
    if (!g_bl611IComCtlModule)
    {
        g_bl611IComCtlModule =
            LoadLibraryA(
                "comctl32.dll"
            );
    }


    if (!g_bl611IComCtlModule)
    {
        ErrorLog(
            "BetterLooting: BSP_UI tooltip comctl32 load failed"
        );

        return false;
    }


    BetterLooting611IInitCommonControlsExFn initFn =
        reinterpret_cast<BetterLooting611IInitCommonControlsExFn>(
            GetProcAddress(
                g_bl611IComCtlModule,
                "InitCommonControlsEx"
            )
        );


    if (initFn)
    {
        INITCOMMONCONTROLSEX init = {};


        init.dwSize =
            sizeof(init);


        init.dwICC =
            ICC_WIN95_CLASSES;


        initFn(
            &init
        );
    }


    return true;
}


static void BetterLooting611LApplyDarkTooltipTheme(
    HWND tooltip
);


static bool BetterLooting611ICreateTooltip(
    HWND parent
)
{
    if (
        !parent ||
        !BetterLooting611IEnsureCommonControls()
    )
    {
        return false;
    }


    if (
        g_bl611ITooltip &&
        IsWindow(
            g_bl611ITooltip
        )
    )
    {
        return true;
    }


    g_bl611ITooltip =
        CreateWindowExA(
            WS_EX_TOPMOST,
            TOOLTIPS_CLASSA,
            NULL,
            WS_POPUP |
                TTS_ALWAYSTIP |
                TTS_NOPREFIX,
            CW_USEDEFAULT,
            CW_USEDEFAULT,
            CW_USEDEFAULT,
            CW_USEDEFAULT,
            parent,
            NULL,
            NULL,
            NULL
        );


    if (!g_bl611ITooltip)
    {
        ErrorLog(
            "BetterLooting: BSP_UI tooltip window create failed"
        );

        return false;
    }


    BetterLooting611LApplyDarkTooltipTheme(
        g_bl611ITooltip
    );


    SetWindowPos(
        g_bl611ITooltip,
        HWND_TOPMOST,
        0,
        0,
        0,
        0,
        SWP_NOMOVE |
            SWP_NOSIZE |
            SWP_NOACTIVATE
    );


    SendMessageA(
        g_bl611ITooltip,
        TTM_SETMAXTIPWIDTH,
        0,
        380
    );


    SendMessageA(
        g_bl611ITooltip,
        TTM_SETDELAYTIME,
        TTDT_INITIAL,
        500
    );


    SendMessageA(
        g_bl611ITooltip,
        TTM_SETDELAYTIME,
        TTDT_RESHOW,
        100
    );


    SendMessageA(
        g_bl611ITooltip,
        TTM_SETDELAYTIME,
        TTDT_AUTOPOP,
        9000
    );


    SendMessageA(
        g_bl611ITooltip,
        TTM_SETTIPBKCOLOR,
        RGB(31, 32, 28),
        0
    );


    SendMessageA(
        g_bl611ITooltip,
        TTM_SETTIPTEXTCOLOR,
        BL_BSP_COLOR_TEXT,
        0
    );


    return true;
}


typedef HRESULT (
    WINAPI*
    BetterLooting611LSetWindowThemeFn
)(
    HWND,
    LPCWSTR,
    LPCWSTR
);


static void BetterLooting611LApplyDarkTooltipTheme(
    HWND tooltip
)
{
    if (!tooltip)
    {
        return;
    }


    if (!g_bl611LUxThemeModule)
    {
        g_bl611LUxThemeModule =
            LoadLibraryA(
                "uxtheme.dll"
            );
    }


    if (g_bl611LUxThemeModule)
    {
        BetterLooting611LSetWindowThemeFn setTheme =
            reinterpret_cast<BetterLooting611LSetWindowThemeFn>(
                GetProcAddress(
                    g_bl611LUxThemeModule,
                    "SetWindowTheme"
                )
            );


        if (setTheme)
        {
            setTheme(
                tooltip,
                L"",
                L""
            );
        }
    }


    SendMessageW(
        tooltip,
        CCM_SETUNICODEFORMAT,
        TRUE,
        0
    );


    SendMessageA(
        tooltip,
        WM_SETFONT,
        reinterpret_cast<WPARAM>(
            g_blBspFontNormal
        ),
        TRUE
    );


    SendMessageA(
        tooltip,
        TTM_SETTIPBKCOLOR,
        RGB(31, 32, 28),
        0
    );


    SendMessageA(
        tooltip,
        TTM_SETTIPTEXTCOLOR,
        RGB(232, 226, 207),
        0
    );
}


static const wchar_t* BetterLooting611LText(
    const wchar_t* spanishText,
    const wchar_t* englishText
)
{
    return
        g_blBspSpanish
            ? spanishText
            : englishText;
}

static bool BetterLooting611IAddTooltip(
    HWND parent,
    HWND control,
    const wchar_t* text
)
{
    if (
        !parent ||
        !control ||
        !text ||
        !g_bl611ITooltip
    )
    {
        return false;
    }


    TOOLINFOW tool = {};


    tool.cbSize =
        sizeof(tool);


    tool.uFlags =
        TTF_IDISHWND |
        TTF_SUBCLASS;


    tool.hwnd =
        parent;


    tool.uId =
        reinterpret_cast<UINT_PTR>(
            control
        );


    tool.lpszText =
        const_cast<LPWSTR>(
            text
        );


    return
        SendMessageW(
            g_bl611ITooltip,
            TTM_ADDTOOLW,
            0,
            reinterpret_cast<LPARAM>(
                &tool
            )
        ) !=
        FALSE;
}

