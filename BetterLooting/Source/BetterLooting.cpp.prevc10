    BetterLootingBspSetCheck(g_blBspCheckMaterials, true);
    BetterLootingBspSetCheck(g_blBspCheckFood, true);
    BetterLootingBspSetCheck(g_blBspCheckMedicine, true);
    BetterLootingBspSetCheck(g_blBspCheckTools, true);
    BetterLootingBspSetCheck(g_blBspCheckAmmo, true);
    BetterLootingBspSetCheck(g_blBspCheckBlueprints, false);
    BetterLootingBspSetCheck(g_blBspCheckBooks, false);
    BetterLootingBspSetCheck(g_blBspCheckRobotics, true);
    BetterLootingBspSetCheck(g_blBspCheckNarcotics, false);
    BetterLootingBspSetCheck(g_blBspCheckSeveredLimbs, false);
    BetterLootingBspSetCheck(g_blBspCheckOther, false);
}

static void BetterLooting611KInvalidatePresetButtons(
    HWND parent
)
{
    if (!parent)
    {
        return;
    }


    const int ids[] =
    {
        BL_UI_611J_ID_BALANCED,
        BL_UI_611J_ID_MONEY,
        BL_UI_611J_ID_RESOURCES
    };


    for (
        int i = 0;
        i < 3;
        ++i
    )
    {
        HWND button =
            GetDlgItem(
                parent,
                ids[i]
            );


        if (button)
        {
            InvalidateRect(
                button,
                NULL,
                FALSE
            );
        }
    }


    HWND saveButton =
        GetDlgItem(
            parent,
            BL_BSP_ID_SAVE
        );


    if (saveButton)
    {
        InvalidateRect(
            saveButton,
            NULL,
            FALSE
        );
    }
}


static void BetterLooting6121RefreshRealSummary()
{
    if (
        !g_bl611HStatus ||
        !g_blBspEditRadius ||
        !g_blBspEditMinValue ||
        !g_blBspEditMinValuePerKg ||
        !g_blBspComboActivationKey
    )
    {
        return;
    }


    char radius[32] = {};
    char minValue[32] = {};
    char minValuePerKg[32] = {};


    GetWindowTextA(
        g_blBspEditRadius,
        radius,
        sizeof(radius)
    );


    GetWindowTextA(
        g_blBspEditMinValue,
        minValue,
        sizeof(minValue)
    );


    GetWindowTextA(
        g_blBspEditMinValuePerKg,
        minValuePerKg,
        sizeof(minValuePerKg)
    );


    LRESULT hotkeySelection =
        SendMessageA(
            g_blBspComboActivationKey,
            CB_GETCURSEL,
            0,
            0
        );


    if (
        hotkeySelection < 0 ||
        hotkeySelection >= g_blBspHotkeyCount
    )
    {
        hotkeySelection =
            BetterLootingBspFindHotkeyIndex(
                g_betterLootingRules.activationVirtualKey
            );
    }


    const char* hotkeyName =
        g_blBspHotkeyNames[
            static_cast<int>(
                hotkeySelection
            )
        ];


    char summary[256] = {};


    if (g_blBspSpanish)
    {
        sprintf_s(
            summary,
            "RADIO %s m  |  VALOR >= %s  |  >= %s/kg  |  TECLA %s",
            radius,
            minValue,
            minValuePerKg,
            hotkeyName
        );
    }
    else
    {
        sprintf_s(
            summary,
            "RADIUS %s m  |  VALUE >= %s  |  >= %s/kg  |  KEY %s",
            radius,
            minValue,
            minValuePerKg,
            hotkeyName
        );
    }


    SetWindowTextA(
        g_bl611HStatus,
        summary
    );
}


static void BetterLooting611KRefreshDirtyStatus(
    HWND parent
)
{
    if (!g_bl611HStatus)
    {
        return;
    }


    if (g_bl611KDirty)
    {
        SetWindowTextW(
            g_bl611HStatus,
            g_blBspSpanish
                ? L"\u25CF CAMBIOS SIN GUARDAR"
                : L"\u25CF UNSAVED CHANGES"
        );
    }
    else
    {
        BetterLooting6121RefreshRealSummary();
    }


    InvalidateRect(
        g_bl611HStatus,
        NULL,
        TRUE
    );


    BetterLooting611KInvalidatePresetButtons(
        parent
    );
}


static void BetterLooting611KMarkCustomDirty(
    HWND parent
)
{
    if (g_bl611KSuppressTracking)
    {
        return;
    }


    g_bl611KActivePresetId =
        0;


    g_bl611KDirty =
        true;


    KillTimer(
        parent,
        BL_UI_611H_TIMER_STATUS
    );


    BetterLooting611KRefreshDirtyStatus(
        parent
    );
}


static void BetterLooting611KSelectPreset(
    HWND parent,
    int presetId
)
{
    if (g_bl611KSuppressTracking)
    {
        return;
    }


    g_bl611KActivePresetId =
        presetId;


    g_bl611KDirty =
        true;


    KillTimer(
        parent,
        BL_UI_611H_TIMER_STATUS
    );


    BetterLooting611KRefreshDirtyStatus(
        parent
    );
}


static void BetterLooting611KMarkSaved(
    HWND parent
)
{
    g_bl611KDirty =
        false;


    KillTimer(
        parent,
        BL_UI_611H_TIMER_STATUS
    );


    BetterLooting611KRefreshDirtyStatus(
        parent
    );
}


static void BetterLooting611KDiscardPendingState(
    HWND parent
)
{
    g_bl611KDirty =
        false;


    g_bl611KActivePresetId =
        0;


    KillTimer(
        parent,
        BL_UI_611H_TIMER_STATUS
    );


    if (g_bl611HStatus)
    {
        SetWindowTextW(
            g_bl611HStatus,
            L""
        );


        InvalidateRect(
            g_bl611HStatus,
            NULL,
            TRUE
        );
    }


    BetterLooting611KInvalidatePresetButtons(
        parent
    );
}

static void BetterLooting611KShowSavedStatus(
    HWND parent
)
{
    if (!g_bl611HStatus)
    {
        return;
    }


    SetWindowTextW(
        g_bl611HStatus,
        g_blBspSpanish
            ? L"\u2713 CONFIGURACI\u00D3N GUARDADA"
            : L"\u2713 SETTINGS SAVED"
    );


    InvalidateRect(
        g_bl611HStatus,
        NULL,
        TRUE
    );


    KillTimer(
        parent,
        BL_UI_611H_TIMER_STATUS
    );


    SetTimer(
        parent,
        BL_UI_611H_TIMER_STATUS,
        2400,
        NULL
    );
}


static bool BetterLooting611KIsTrackedCheck(
    HWND control
)
{
    return
        control == g_blBspCheckWeapons ||
        control == g_blBspCheckArmour ||
        control == g_blBspCheckMaterials ||
        control == g_blBspCheckFood ||
        control == g_blBspCheckMedicine ||
        control == g_blBspCheckTools ||
        control == g_blBspCheckAmmo ||
        control == g_blBspCheckBlueprints ||
        control == g_blBspCheckBooks ||
        control == g_blBspCheckRobotics ||
        control == g_blBspCheckNarcotics ||
        control == g_blBspCheckSeveredLimbs ||
        control == g_blBspCheckOther ||
        control == g_blBspCheckAllowStolen ||
        control == g_blBspCheckBestItemsFirst ||
        control == g_blBspCheckPreferBackpack;
}

static LRESULT CALLBACK BetterLooting611BCheckProc(
    HWND hwnd,
    UINT msg,
    WPARAM wParam,
    LPARAM lParam
)
{
    if (
        msg == WM_PAINT
    )
    {
        PAINTSTRUCT paint = {};


        HDC hdc =
            BeginPaint(
                hwnd,
                &paint
            );


        RECT client = {};


        GetClientRect(
            hwnd,
            &client
        );


        FillRect(
            hdc,
            &client,
            g_blBspBrushPanel
        );


        const bool checked =
            SendMessageA(
                hwnd,
                BM_GETCHECK,
                0,
                0
            ) ==
            BST_CHECKED;


        RECT box =
        {
            2,
            (client.bottom - 18) / 2,
            20,
            ((client.bottom - 18) / 2) + 18
        };


        HBRUSH boxBrush =
            CreateSolidBrush(
                checked
                    ? RGB(152, 103, 45)
                    : RGB(24, 25, 22)
            );


        FillRect(
            hdc,
            &box,
            boxBrush
        );


        DeleteObject(
            boxBrush
        );


        HBRUSH borderBrush =
            CreateSolidBrush(
                checked
                    ? RGB(210, 157, 82)
                    : RGB(105, 102, 87)
            );


        FrameRect(
            hdc,
            &box,
            borderBrush
        );


        DeleteObject(
            borderBrush
        );


        if (checked)
        {
            HPEN checkPen =
                CreatePen(
                    PS_SOLID,
                    2,
                    RGB(244, 236, 211)
                );


            HGDIOBJ oldPen =
                SelectObject(
                    hdc,
                    checkPen
                );


            MoveToEx(
                hdc,
                box.left + 4,
                box.top + 9,
                NULL
            );


            LineTo(
                hdc,
                box.left + 8,
                box.top + 13
            );


            LineTo(
                hdc,
                box.left + 15,
                box.top + 5
            );


            SelectObject(
                hdc,
                oldPen
            );


            DeleteObject(
                checkPen
            );
        }


        char caption[256] = {};


        GetWindowTextA(
            hwnd,
            caption,
            sizeof(caption)
        );


        RECT textRect =
        {
            30,
            0,
            client.right,
            client.bottom
        };


        SetBkMode(
            hdc,
            TRANSPARENT
        );


        SetTextColor(
            hdc,
            IsWindowEnabled(hwnd)
                ? RGB(232, 226, 207)
                : RGB(128, 125, 112)
        );


        HGDIOBJ oldFont =
            SelectObject(
                hdc,
                g_blBspFontNormal
            );


        DrawTextA(
            hdc,
            caption,
            -1,
            &textRect,
            DT_LEFT |
                DT_VCENTER |
                DT_SINGLELINE |
                DT_NOPREFIX |
                DT_END_ELLIPSIS
        );


        SelectObject(
            hdc,
            oldFont
        );


        if (GetFocus() == hwnd)
        {
            RECT focusRect =
            {
                27,
                2,
                client.right - 2,
                client.bottom - 2
            };


            DrawFocusRect(
                hdc,
                &focusRect
            );
        }


        EndPaint(
            hwnd,
            &paint
        );


        return 0;
    }


    if (
        msg == BM_SETCHECK ||
        msg == WM_LBUTTONUP ||
        msg == WM_KEYUP ||
        msg == WM_ENABLE ||
        msg == WM_SETFOCUS ||
        msg == WM_KILLFOCUS
    )
    {
        const LRESULT result =
            g_bl611BOriginalCheckProc
                ? CallWindowProcA(
                    g_bl611BOriginalCheckProc,
                    hwnd,
                    msg,
                    wParam,
                    lParam
                )
                : DefWindowProcA(
                    hwnd,
                    msg,
                    wParam,
                    lParam
                );


        InvalidateRect(
            hwnd,
            NULL,
            FALSE
        );


        return result;
    }


    return
        g_bl611BOriginalCheckProc
            ? CallWindowProcA(
                g_bl611BOriginalCheckProc,
                hwnd,
                msg,
                wParam,
                lParam
            )
            : DefWindowProcA(
                hwnd,
                msg,
                wParam,
                lParam
            );
}


static HWND BetterLootingBspCreateCheck(
    HWND parent,
    const char* text,
    int x,
    int y,
    int width,
    int height
)
{
    HWND control =
        CreateWindowExA(
            0,
            "BUTTON",
            text,
            WS_CHILD |
                WS_VISIBLE |
                WS_TABSTOP |
                BS_AUTOCHECKBOX,
            x,
            y,
            width,
            height,
            parent,
            NULL,
            reinterpret_cast<HINSTANCE>(
                &__ImageBase
            ),
            NULL
        );


    BetterLootingBspSetControlFont(
        control,
        g_blBspFontNormal
    );


    if (control)
    {
        if (!g_bl611BOriginalCheckProc)
        {
            g_bl611BOriginalCheckProc =
                reinterpret_cast<WNDPROC>(
                    GetWindowLongPtrA(
                        control,
                        GWLP_WNDPROC
                    )
                );
        }


        SetWindowLongPtrA(
            control,
            GWLP_WNDPROC,
            reinterpret_cast<LONG_PTR>(
                BetterLooting611BCheckProc
            )
        );
    }


    return control;
}

