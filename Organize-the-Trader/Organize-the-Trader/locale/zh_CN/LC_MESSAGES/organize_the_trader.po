msgid "A search bar and sorting in the trade window."
msgstr "交易窗口中的搜索和排序。"

msgid "Enabled"
msgstr "启用"

msgid "Enable Organize the Trader search controls"
msgstr "开启或关闭整个模组"

msgid "Show entry count"
msgstr "显示条目数"

msgid "Show visible and total entry counts in the search bar"
msgstr "在搜索框旁显示可见条目数和总条目数"

msgid "Show quantity count"
msgstr "显示数量"

msgid "Show visible stack quantity in the search bar"
msgstr "在搜索框旁显示可见堆叠的总数量"

msgid "Show clear button"
msgstr "清除按钮"

msgid "Show the clear button inside the search bar"
msgstr "搜索框内的清除按钮"

msgid "Auto-focus search"
msgstr "自动聚焦搜索框"

msgid "Focus the trader search input automatically when controls are injected"
msgstr "打开交易窗口时自动将光标放入搜索框"

msgid "Search input width"
msgstr "搜索框宽度"

msgid "Desired search input width in pixels"
msgstr "搜索框宽度（像素）"

msgid "Search input height"
msgstr "搜索框高度"

msgid "Desired search input height in pixels"
msgstr "搜索框高度（像素）"

msgid "Sort panel width"
msgstr "排序面板宽度"

msgid "Desired sort panel width in pixels"
msgstr "排序面板宽度（像素）"

msgid "Sort panel height"
msgstr "排序面板高度"

msgid "Desired sort panel height in pixels"
msgstr "排序面板高度（像素）"

msgid "Debug logging"
msgstr "详细日志"

msgid "Write detailed logs to RE_Kenshi_log.txt"
msgstr "将详细日志写入 RE_Kenshi_log.txt"

msgid "Search items..."
msgstr "搜索物品..."

msgid "Sort"
msgstr "排序"

msgid "Default"
msgstr "默认"

msgid "By name"
msgstr "按名称"

msgid "Unit price"
msgstr "单价"

msgid "Stack value"
msgstr "整组价值"

msgid "Unit weight"
msgstr "单件重量"

msgid "Stack weight"
msgstr "整组重量"

msgid "Price / weight"
msgstr "价格/重量"

msgid "Sort list width"
msgstr "排序列表宽度"

msgid "Preferred sort list width in pixels. 0 fits its translated items. Narrow windows use separate rows."
msgstr "排序列表的期望宽度（像素）。0表示根据翻译后的选项自动调整；窄窗口会分行显示控件。"

msgid "Deal"
msgstr "交易"

msgid "Search field width"
msgstr "搜索框宽度"

msgid "Preferred search field width in pixels. Readable text takes priority; narrow windows use separate rows."
msgstr "搜索框的期望宽度（像素）。优先保证文字可读；窄窗口会分行显示控件。"

msgid "Deal balance"
msgstr "交易盈亏"

msgid "Show the current deal balance at the centre of the trader header (plus - gain, minus - cost)."
msgstr "在商人窗口顶部中央显示本次交易结算（加号为收入，减号为支出）。"

msgid "Trader"
msgstr "商人"

msgid "Player"
msgstr "玩家"
