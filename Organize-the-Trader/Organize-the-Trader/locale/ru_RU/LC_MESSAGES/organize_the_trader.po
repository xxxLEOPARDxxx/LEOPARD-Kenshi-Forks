msgid "A search bar and sorting in the trade window."
msgstr "Поиск и сортировка в окне торговли."

msgid "Enabled"
msgstr "Включено"

msgid "Enable Organize the Trader search controls"
msgstr "Включает и выключает весь мод"

msgid "Show entry count"
msgstr "Показывать число строк"

msgid "Show visible and total entry counts in the search bar"
msgstr "Показывать рядом с поиском, сколько строк видно из всех"

msgid "Show quantity count"
msgstr "Показывать количество"

msgid "Show visible stack quantity in the search bar"
msgstr "Показывать рядом с поиском общее количество в видимых стопках"

msgid "Show clear button"
msgstr "Кнопка очистки"

msgid "Show the clear button inside the search bar"
msgstr "Кнопка в поле поиска, которая его очищает"

msgid "Auto-focus search"
msgstr "Сразу ставить курсор в поиск"

msgid "Focus the trader search input automatically when controls are injected"
msgstr "Курсор сразу в поле поиска, когда открывается торговля"

msgid "Search input width"
msgstr "Ширина поля поиска"

msgid "Desired search input width in pixels"
msgstr "Ширина поля поиска в пикселях"

msgid "Search input height"
msgstr "Высота поля поиска"

msgid "Desired search input height in pixels"
msgstr "Высота поля поиска в пикселях"

msgid "Sort panel width"
msgstr "Ширина панели сортировки"

msgid "Desired sort panel width in pixels"
msgstr "Ширина панели сортировки в пикселях"

msgid "Sort panel height"
msgstr "Высота панели сортировки"

msgid "Desired sort panel height in pixels"
msgstr "Высота панели сортировки в пикселях"

msgid "Debug logging"
msgstr "Подробный журнал"

msgid "Write detailed logs to RE_Kenshi_log.txt"
msgstr "Писать подробности в RE_Kenshi_log.txt"

msgid "Search items..."
msgstr "Поиск предметов..."

msgid "Sort"
msgstr "Сорт"

msgid "Default"
msgstr "По умолчанию"

msgid "By name"
msgstr "По имени"

msgid "Unit price"
msgstr "Цена за штуку"

msgid "Stack value"
msgstr "Стоимость стопки"

msgid "Unit weight"
msgstr "Вес за штуку"

msgid "Stack weight"
msgstr "Вес стопки"

msgid "Price / weight"
msgstr "Цена / вес"

msgid "Sort list width"
msgstr "Ширина списка сортировки"

msgid "Preferred sort list width in pixels. 0 fits its translated items. Narrow windows use separate rows."
msgstr "Желаемая ширина списка сортировки в пикселях. 0 - по длине переведённых пунктов. В узком окне панели переносятся на отдельные строки."

msgid "Deal"
msgstr "Сделка"

msgid "Search field width"
msgstr "Ширина поля поиска"

msgid "Preferred search field width in pixels. Readable text takes priority; narrow windows use separate rows."
msgstr "Желаемая ширина поиска в пикселях. Читаемый текст важнее ширины; в узком окне панели переносятся на отдельные строки."

msgid "Deal balance"
msgstr "Итог сделки"

msgid "Show the current deal balance at the centre of the trader header (plus - gain, minus - cost)."
msgstr "Итог текущей сделки в центре верхней строки торговца (плюс - доход, минус - расход)."

msgid "Trader"
msgstr "Торговец"

msgid "Player"
msgstr "Игрок"
