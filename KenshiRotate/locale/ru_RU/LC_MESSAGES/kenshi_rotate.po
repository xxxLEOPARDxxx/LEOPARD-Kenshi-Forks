msgid ""
msgstr "Language: ru_RU\nContent-Type: text/plain; charset=UTF-8\n"

msgid "Cannot rotate: item is equipped"
msgstr "Нельзя вращать: предмет экипирован"

msgid "Cannot rotate: item is square"
msgstr "Нельзя вращать: предмет квадратный"

msgid "Cannot rotate: not enough space"
msgstr "Нельзя вращать: недостаточно места"

msgid "Cannot rotate: save/load hooks failed"
msgstr "Нельзя вращать: ошибка хуков сохранения/загрузки"

msgid "Cannot rotate: this inventory doesn't accept items"
msgstr "Нельзя вращать: этот инвентарь не принимает предметы"

msgid "Detailed log"
msgstr "Подробный журнал"

msgid "Details in RE_Kenshi_log.txt: input settings, rotation attempts and results."
msgstr "В RE_Kenshi_log.txt: настройки управления, попытки и результаты вращения."

msgid "Disables new rotations only. Existing rotations keep their appearance and save correctly."
msgstr "Отключается только новый поворот. Уже повёрнутые предметы отображаются и сохраняются правильно."

msgid "Enable rotation input"
msgstr "Разрешить поворот предметов"

msgid "KenshiRotate: some hooks failed to install (see log); features may not work correctly"
msgstr "KenshiRotate: часть хуков не установлена. Проверьте журнал; некоторые функции могут не работать."

msgid "Press one key or mouse button, with optional CTRL, SHIFT or ALT. NONE disables rotation input."
msgstr "Одна клавиша или кнопка мыши с необязательными CTRL, SHIFT или ALT. NONE отключает ввод поворота."

msgid "Rotate inventory items with one keyboard or mouse binding. Existing rotations stay save-compatible."
msgstr "Поворот предметов одной клавишей или кнопкой мыши. Существующие повороты совместимы с сохранениями."

msgid "Rotation binding"
msgstr "Кнопка поворота"
