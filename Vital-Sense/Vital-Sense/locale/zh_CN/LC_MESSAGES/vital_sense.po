msgid "Highlights downed characters with state markers, an optional body tint and bounty indicators."
msgstr "用状态标记、可选的身体着色和悬赏标识高亮倒地的角色。"

msgid "Core"
msgstr "常规"

msgid "Enabled"
msgstr "启用"

msgid "Enable all Vital Sense overlays and tint behavior"
msgstr "开启或关闭整个模组"

msgid "Highlight key"
msgstr "高亮按键"

msgid "Primary key that gates KO highlights. Clear to Unbound for always-on highlights."
msgstr "按住此键时高亮倒地角色。NONE - 始终高亮"

msgid "Require Ctrl"
msgstr "需要 Ctrl"

msgid "Require Ctrl to be held with the highlight key"
msgstr "需要同时按住 Ctrl 和高亮按键"

msgid "Require Shift"
msgstr "需要 Shift"

