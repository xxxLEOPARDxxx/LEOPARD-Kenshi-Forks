msgid "Highlights downed characters with state markers, an optional body tint and bounty indicators."
msgstr "Выделяет лежащих персонажей: метки состояния, по желанию окраска тела и значки награды за голову."

msgid "Core"
msgstr "Общее"

msgid "Enabled"
msgstr "Включено"

msgid "Enable all Vital Sense overlays and tint behavior"
msgstr "Включает и выключает весь мод"

msgid "Highlight key"
msgstr "Клавиша подсветки"

msgid "Primary key that gates KO highlights. Clear to Unbound for always-on highlights."
msgstr "Пока зажата эта клавиша, лежащие выделены. NONE - выделены всегда"

msgid "Require Ctrl"
msgstr "Нужен Ctrl"

msgid "Require Ctrl to be held with the highlight key"
msgstr "Вместе с клавишей подсветки нужно держать Ctrl"

msgid "Require Shift"
msgstr "Нужен Shift"

msgid "Require Shift to be held with the highlight key"
msgstr "Вместе с клавишей подсветки нужно держать Shift"

msgid "Require Alt"
msgstr "Нужен Alt"

msgid "Require Alt to be held with the highlight key"
msgstr "Вместе с клавишей подсветки нужно держать Alt"

msgid "Max highlight distance"
msgstr "Наибольшее расстояние подсветки"

msgid "Maximum horizontal distance from camera center for highlights"
msgstr "На каком расстоянии от центра камеры выделять персонажей"

msgid "Show icons"
msgstr "Показывать значки"

msgid "Render icon widgets for KO states"
msgstr "Значки состояний"

msgid "Show text"
msgstr "Показывать текст"

msgid "Render short state labels such as ZZ and DY"
msgstr "Короткий текст состояния вроде ZZ или DY"

msgid "States"
msgstr "Состояния"

msgid "Show unconscious"
msgstr "Без сознания"

msgid "Show markers for unconscious targets"
msgstr "Метки у лежащих без сознания"

msgid "Show recovery coma"
msgstr "Кома"

msgid "Show markers for recovery coma targets"
msgstr "Метки у лежащих в коме"

msgid "Show dying"
msgstr "При смерти"

msgid "Show markers for dying targets"
msgstr "Метки у умирающих"

msgid "Show playing dead"
msgstr "Притворяется мёртвым"

msgid "Show markers for playing dead targets"
msgstr "Метки у притворяющихся мёртвыми"

msgid "Show dead"
msgstr "Мёртвые"

msgid "Show markers for dead targets"
msgstr "Метки у мёртвых"

msgid "Unconscious text"
msgstr "Текст: без сознания"

msgid "Short label for the unconscious marker"
msgstr "Короткий текст метки: без сознания"

msgid "Recovery coma text"
msgstr "Текст: комы"

msgid "Short label for the recovery coma marker"
msgstr "Короткий текст метки: комы"

msgid "Dying text"
msgstr "Текст: при смерти"

msgid "Short label for the dying marker"
msgstr "Короткий текст метки: при смерти"

msgid "Playing dead text"
msgstr "Текст: притворства"

msgid "Short label for the playing dead marker"
msgstr "Короткий текст метки: притворства"

msgid "Dead text"
msgstr "Текст: мёртвых"

msgid "Short label for the dead marker"
msgstr "Короткий текст метки: мёртвых"

msgid "Unconscious text size"
msgstr "Размер текста: без сознания"

msgid "Font height for the unconscious label"
msgstr "Высота шрифта текста: без сознания"

msgid "Recovery coma text size"
msgstr "Размер текста: комы"

msgid "Font height for the recovery coma label"
msgstr "Высота шрифта текста: комы"

msgid "Dying text size"
msgstr "Размер текста: при смерти"

msgid "Font height for the dying label"
msgstr "Высота шрифта текста: при смерти"

msgid "Playing dead text size"
msgstr "Размер текста: притворства"

