msgid ""
msgstr "Language: zh_CN\nContent-Type: text/plain; charset=UTF-8\nMIME-Version: 1.0\n"

msgid "Sort [{n}]"
msgstr "整理 [{n}]"

msgid "Sort. [{n}]"
msgstr "整理 [{n}]"

msgid "Sort items. Left-click cycles arrangements; right-click restores item positions."
msgstr "整理物品。左键切换排列方案；右键恢复物品位置。"

msgid "H"
msgstr "高"

msgid "W"
msgstr "宽"

msgid "<"
msgstr "<"

msgid ">"
msgstr ">"

msgid "StackSort: some hooks failed to install (see RE_Kenshi log); sorting may not work correctly"
msgstr "StackSort：部分功能挂接失败（请查看 RE_Kenshi 日志），整理可能无法正常工作"

msgid "StackSort: {n} problem(s) in StackSort.cfg were ignored (see RE_Kenshi log)"
msgstr "StackSort：已忽略 StackSort.cfg 中的 {n} 个问题（请查看 RE_Kenshi 日志）"

msgid "Pack inventory items, merge compatible split stacks and reserve free space."
msgstr "紧凑排列物品，合并兼容的分散堆叠，并预留空间。"

msgid "Enable Stack Sort"
msgstr "启用 Stack Sort"

msgid "Replace Arrange in inventories with room to sort. Single-slot storage keeps its original controls."
msgstr "在有整理空间的物品栏中替换整理按钮。单格储存容器保留原有控件。"

msgid "Merge split stacks"
msgstr "合并分散堆叠"

msgid "On sort clicks, merge compatible stacks after contents or remaining charges change. Uses the game's item and ownership rules. Undo restores positions, without splitting stacks."
msgstr "点击整理时，在物品或剩余使用次数变化后重新合并兼容堆叠。遵循游戏的物品及所有权规则。撤销仅恢复位置，不会拆分堆叠。"

msgid "Height"
msgstr "高度"

msgid "Width"
msgstr "宽度"

msgid "Starting free-space direction"
msgstr "初始空余空间方向"

msgid "Starting H/W mode when the plugin starts. The inventory H/W button changes it during play."
msgstr "插件启动时使用的高/宽模式。游戏中可通过物品栏的高/宽按钮切换。"

msgid "Solutions to cycle"
msgstr "循环方案数"

msgid "Number of best arrangements shown by repeated clicks on StackSort."
msgstr "反复点击 StackSort 时显示的最佳排列方案数量。"

msgid "Background workers"
msgstr "后台线程数"

msgid "Threads used to prepare inventory arrangements. More workers can increase CPU use."
msgstr "用于预先计算物品排列的线程数。更多线程可能增加处理器负载。"

msgid "Detailed log"
msgstr "详细日志"

msgid "Log sorting, stack merging, rotation detection and background jobs in RE_Kenshi_log.txt. Errors are always logged."
msgstr "将整理、堆叠合并、旋转检测及后台任务写入 RE_Kenshi_log.txt。错误始终记录。"
