msgid ""
msgstr ""
"Project-Id-Version: Loot-Scoot-Execute\n"
"Language: en_GB\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Adds an Execute action for downed enemies to the right-click menu."
msgstr "Adds an Execute action for downed enemies to the right-click menu."

msgid "Enabled"
msgstr "Enabled"

msgid "Enable Loot-Scoot-Execute"
msgstr "Turns the whole mod on and off"

msgid "Enable execute kill sound"
msgstr "Kill sound"

msgid "Play execute kill sound when execute dispatch succeeds"
msgstr "Plays a sound when an execution succeeds"

msgid "Debug execute logging"
msgstr "Detailed log"

msgid "Enable focused execute investigation logs in RE_Kenshi_log.txt"
msgstr "Writes execution details to RE_Kenshi_log.txt"

msgid "Enable Execute All"
msgstr "Execute All"

msgid "Show the Execute All button and allow batch execute behavior"
msgstr "A button that executes all downed enemies around the target"

msgid "Ignore execute alliance check"
msgstr "Execute non-hostiles too"

msgid "Allow execute on incapacitated non-hostiles; player characters remain blocked"
msgstr "Allows executing downed neutrals too; your own characters never"

msgid "Execute distance"
msgstr "Execute distance"

msgid "Required distance before queued execute triggers (default 2, max 200)"
msgstr "How close the executioner must come before striking. Default 2"

msgid "Execute All radius"
msgstr "Execute All radius"

msgid "Search radius for Execute All around the selected target (default 10, max 200)"
msgstr "How far around the target Execute All looks for downed enemies. Default 10"

msgid "Execute button width"
msgstr "Execute button width"

msgid "Execute button width in pixels (default 310)"
msgstr "Width of the Execute button, px. Default 310"

msgid "Execute button height"
msgstr "Execute button height"

msgid "Execute button height in pixels (default 56)"
msgstr "Height of the Execute button, px. Default 56"

msgid "Execute button gap"
msgstr "Execute button gap"

msgid "Vertical gap in pixels between Execute rows; use negative values to overlap (default -8)"
msgstr "Gap between the Execute rows, px; minus - they overlap. Default -8"

msgid "Execute button X"
msgstr "Execute button X"

msgid "Horizontal offset in pixels from the default anchored position"
msgstr "Moves the button left or right from its usual place, px"

msgid "Execute button Y"
msgstr "Execute button Y"

msgid "Vertical offset in pixels from the default anchored position"
msgstr "Moves the button up or down from its usual place, px"

msgid "Reset Execute button defaults"
msgstr "Default button size and place"

msgid "Restore Execute button defaults to 310 width, 56 height, gap -8, X 0, and Y 0"
msgstr "Sets the button back to width 310, height 56, gap -8, offsets 0"

msgid "Execute"
msgstr "Execute"

msgid "Execute All"
msgstr "Execute All"
