msgstr ""
"Project-Id-Version: Wall-B-Gone\n"
"Language: ru_RU\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Dismantles the selected wall, bed or furniture with a hotkey and returns the materials."
msgstr "Разбирает выделенную стену, кровать или мебель по клавише и возвращает материалы."

msgid "Enabled"
msgstr "Включено"

msgid "Enable Wall-B-Gone features"
msgstr "Включает и выключает весь мод"

msgid "Allow bed and furniture dismantle"
msgstr "Разбирать кровати и мебель"

msgid "Allow dismantle behavior for beds and common furniture"
msgstr "Разбирать можно и кровати с обычной мебелью; кровати - только пустые"

msgid "Dismantle hotkey"
msgstr "Клавиша разборки"

msgid "Primary key used to dismantle the selected wall, bed, or furniture. Hold Ctrl, Shift, or Alt while capturing to store a combo."
msgstr "Клавиша, которая разбирает выделенную стену, кровать или мебель (а если включено - любую свою постройку). Пишется текстом: X, CTRL+X, SHIFT+ALT+X; NONE - без клавиши"

msgid "Reset hotkey default"
msgstr "Клавиша по умолчанию"

msgid "Reset dismantle hotkey and modifier requirements to defaults"
msgstr "Возвращает клавишу разборки X без Ctrl, Shift и Alt"

msgid "Advanced"
msgstr "Дополнительно"

msgid "Debug logging"
msgstr "Подробный журнал"

msgid "Write extra runtime diagnostics to the RE_Kenshi log"
msgstr "Пишет дополнительные подробности в RE_Kenshi_log.txt"

msgid "Dismantle any own building"
msgstr "Разбирать любые свои постройки"

msgid "Dismantle any selected building of yours, not only walls and furniture; storage must be empty and nobody inside"
msgstr "Клавиша разбирает любую выделенную постройку вашей фракции, не только стены и мебель. Хранилище или станок должны быть пусты, внутри никого, внутри и на ней ничего не построено"
